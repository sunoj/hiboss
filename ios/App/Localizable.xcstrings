    "Choose Discord, Telegram or API delivery. This doesn’t change who receives messages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Discord, Telegram or API delivery. This doesn’t change who receives messages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择通过 Discord、Telegram 或 API 送达。此设置不会更改收件人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord、Telegram、API での配信を選択します。メッセージの受信者は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord, Telegram 또는 API 전달을 선택하세요. 메시지 수신자는 바뀌지 않아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกการส่งผ่าน Discord, Telegram หรือ API ซึ่งจะไม่เปลี่ยนผู้รับข้อความ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la entrega por Discord, Telegram o API. Esto no cambia quién recibe los mensajes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord, Telegram या API डिलीवरी चुनें। इससे यह नहीं बदलता कि संदेश किसे मिलते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التسليم عبر Discord أو Telegram أو API. لا يغيّر هذا مَن يتلقى الرسائل."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a entrega por Discord, Telegram ou API. Isso não muda quem recebe as mensagens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la distribution par Discord, Telegram ou API. Cela ne change pas le destinataire des messages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите доставку через Discord, Telegram или API. Получатель сообщений не изменится."
          }
        }
      }
    },
    "Change phone alerts and delivery to other channels by priority.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change phone alerts and delivery to other channels by priority."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按优先级更改手机通知和其他渠道的通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先度ごとに端末通知と他のチャンネルへの配信を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우선순위별로 휴대폰 알림과 다른 채널 전달을 변경하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนการแจ้งเตือนบนโทรศัพท์และการส่งไปยังช่องทางอื่นตามลำดับความสำคัญ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia los avisos del teléfono y la entrega a otros canales según la prioridad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राथमिकता के अनुसार फ़ोन अलर्ट और अन्य चैनलों पर डिलीवरी बदलें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر تنبيهات الهاتف والتسليم إلى القنوات الأخرى حسب الأولوية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere os alertas no telefone e a entrega em outros canais por prioridade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez les alertes du téléphone et la distribution vers d’autres canaux selon la priorité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените оповещения на телефон и доставку в другие каналы по приоритету."
          }
        }
      }
    },
