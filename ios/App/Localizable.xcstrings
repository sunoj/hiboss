            "state": "translated",
            "value": "삭제되었거나 만료되었을 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจถูกล้างหรือหมดอายุแล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que se haya borrado o haya caducado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद इसे हटा दिया गया है या इसकी समय-सीमा समाप्त हो गई है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما تم مسحها أو انتهت صلاحيتها."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvez tenha sido apagada ou tenha expirado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a peut-être été effacé ou a expiré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, оно удалено или истекло."
          }
        }
      }
    },
