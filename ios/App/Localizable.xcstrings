    "Showing messages sent without a session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing messages sent without a session."
          }
        },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "显示未关联会话的消息。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "セッションなしで送信されたメッセージを表示しています。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "세션 없이 전송된 메시지를 표시하는 중이에요." } },
        "th": { "stringUnit": { "state": "translated", "value": "กำลังแสดงข้อความที่ส่งโดยไม่มีเซสชัน" } },
        "es": { "stringUnit": { "state": "translated", "value": "Se muestran los mensajes enviados sin sesión." } },
        "hi": { "stringUnit": { "state": "translated", "value": "बिना सेशन के भेजे गए संदेश दिखाए जा रहे हैं।" } },
        "ar": { "stringUnit": { "state": "translated", "value": "يتم عرض الرسائل المرسلة دون جلسة." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Mostrando mensagens enviadas sem uma sessão." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Affichage des messages envoyés sans session." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показаны сообщения, отправленные вне сеанса." } }
      }
    },
    "This session is no longer available. Showing its saved messages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is no longer available. Showing its saved messages."
          }
        },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此会话已不可用，正在显示其已保存的消息。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このセッションは利用できなくなりました。保存されたメッセージを表示しています。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 세션은 더 이상 사용할 수 없어요. 저장된 메시지를 표시하는 중이에요." } },
        "th": { "stringUnit": { "state": "translated", "value": "เซสชันนี้ไม่พร้อมใช้งานแล้ว กำลังแสดงข้อความที่บันทึกไว้" } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta sesión ya no está disponible. Se muestran sus mensajes guardados." } },
        "hi": { "stringUnit": { "state": "translated", "value": "यह सेशन अब उपलब्ध नहीं है। इसके सहेजे गए संदेश दिखाए जा रहे हैं।" } },
        "ar": { "stringUnit": { "state": "translated", "value": "لم تعد هذه الجلسة متاحة. يتم عرض رسائلها المحفوظة." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Esta sessão não está mais disponível. Mostrando as mensagens salvas." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cette session n’est plus disponible. Affichage de ses messages enregistrés." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Этот сеанс больше недоступен. Показаны сохранённые сообщения." } }
      }
    },
