        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर तक नहीं पहुँच सके।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم."
          }
        },
