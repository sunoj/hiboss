    "A machine that runs hiboss setup with an invite appears here for approval.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A machine that runs hiboss setup with an invite appears here for approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用邀请运行 hiboss setup 的机器会显示在这里等待批准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待を使って hiboss setup を実行したマシンは、承認待ちとしてここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대로 hiboss setup을 실행한 머신이 승인을 위해 여기에 표시됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องที่รัน hiboss setup ด้วยคำเชิญจะแสดงที่นี่เพื่อรอการอนุมัติ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las máquinas que ejecutan hiboss setup con una invitación aparecen aquí para su aprobación."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो मशीन आमंत्रण के साथ hiboss setup चलाती है, वह स्वीकृति के लिए यहां दिखाई देती है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر هنا للموافقة أي جهاز يشغّل hiboss setup باستخدام دعوة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma máquina que executa hiboss setup com um convite aparece aqui para aprovação."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une machine qui exécute hiboss setup avec une invitation apparaît ici pour approbation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина, выполнившая hiboss setup с приглашением, появится здесь для одобрения."
          }
        }
      }
    },
