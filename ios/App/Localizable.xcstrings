    "Only an admin can approve devices": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an admin can approve devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员可以批准设备"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを承認できるのは管理者のみです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자만 기기를 승인할 수 있습니다"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ดูแลระบบเท่านั้นที่อนุมัติอุปกรณ์ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un administrador puede aprobar dispositivos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एडमिन ही डिवाइस स्वीकृत कर सकता है"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمسؤول فقط الموافقة على الأجهزة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente um administrador pode aprovar dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un administrateur peut approuver des appareils"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только администратор может одобрять устройства"
          }
        }
      }
    },
    "Ask an admin of this HiBoss server to approve new machines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask an admin of this HiBoss server to approve new machines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让此 HiBoss 服务器的管理员批准新机器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいマシンの承認は、この HiBoss サーバーの管理者に依頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 HiBoss 서버의 관리자에게 새 머신 승인을 요청하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดขอให้ผู้ดูแลเซิร์ฟเวอร์ HiBoss นี้อนุมัติเครื่องใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a un administrador de este servidor HiBoss que apruebe las máquinas nuevas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई मशीनों को स्वीकृत करने के लिए इस HiBoss सर्वर के एडमिन से कहें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من مسؤول خادم HiBoss هذا الموافقة على الأجهزة الجديدة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça a um administrador deste servidor HiBoss para aprovar novas máquinas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un administrateur de ce serveur HiBoss d’approuver les nouvelles machines."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите администратора этого сервера HiBoss одобрить новые машины."
          }
        }
      }
    },
