    "No eligible agent message. Resolved decisions cannot receive replies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No eligible agent message. Resolved decisions cannot receive replies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可回复的智能体消息。已解决的决策无法接收回复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信できるエージェントのメッセージがありません。解決済みの判断には返信できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장할 수 있는 에이전트 메시지가 없어요. 해결된 결정에는 답장할 수 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อความจากเอเจนต์ที่ตอบกลับได้ การตัดสินใจที่ได้ข้อยุติแล้วจะรับการตอบกลับไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún mensaje de agente al que responder. Las decisiones resueltas no admiten respuestas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब देने योग्य कोई एजेंट संदेश नहीं है। हल हो चुके निर्णयों पर जवाब नहीं दिया जा सकता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد رسالة وكيل مؤهلة. لا يمكن الرد على القرارات المحسومة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma mensagem de agente disponível. Decisões resolvidas não recebem respostas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun message d’agent auquel répondre. Les décisions résolues ne peuvent pas recevoir de réponse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сообщений агента, на которые можно ответить. На принятые решения ответить нельзя."
          }
        }
      }
    },
    "This draft's target is unavailable. Discard it or choose a newer message.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft's target is unavailable. Discard it or choose a newer message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿的回复对象已不可用。请丢弃草稿或选择更新的消息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この下書きの返信先は利用できません。下書きを破棄するか、新しいメッセージを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초안의 답장 대상을 사용할 수 없어요. 초안을 삭제하거나 최신 메시지를 선택하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมายของฉบับร่างนี้ไม่พร้อมใช้งาน ทิ้งฉบับร่างหรือเลือกข้อความที่ใหม่กว่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destino de este borrador no está disponible. Descártalo o elige un mensaje más reciente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ड्राफ़्ट का लक्ष्य उपलब्ध नहीं है। इसे हटाएँ या कोई नया संदेश चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدف هذه المسودة غير متاح. تجاهلها أو اختر رسالة أحدث."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O destino deste rascunho não está disponível. Descarte-o ou escolha uma mensagem mais recente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cible de ce brouillon n’est plus disponible. Supprimez-le ou choisissez un message plus récent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адресат черновика недоступен. Удалите черновик или выберите более новое сообщение."
          }
        }
      }
    },
