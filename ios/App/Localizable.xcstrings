    "This request has no verification code, so it can’t be approved here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request has no verification code, so it can’t be approved here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求没有验证码，因此无法在此批准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストには確認コードがないため、ここでは承認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청에는 인증 코드가 없어 여기에서 승인할 수 없습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอนี้ไม่มีรหัสยืนยัน จึงอนุมัติที่นี่ไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud no tiene código de verificación, así que no se puede aprobar aquí."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अनुरोध में सत्यापन कोड नहीं है, इसलिए इसे यहां स्वीकृत नहीं किया जा सकता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن هذا الطلب رمز تحقق، لذا لا يمكن الموافقة عليه هنا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitação não tem código de verificação, então não pode ser aprovada aqui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande n’a pas de code de vérification ; elle ne peut donc pas être approuvée ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого запроса нет кода подтверждения, поэтому его нельзя одобрить здесь."
          }
        }
      }
    },
