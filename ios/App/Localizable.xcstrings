    "Show a generic alert. Message content loads from your server when you open HiBoss.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a generic alert. Message content loads from your server when you open HiBoss."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示通用提醒。打开 HiBoss 后从你的服务器加载消息内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "汎用の通知を表示します。メッセージの内容は HiBoss を開いたときにサーバーから読み込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 알림을 표시해요. 메시지 내용은 HiBoss를 열 때 서버에서 로드돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงการแจ้งเตือนทั่วไป เนื้อหาข้อความจะโหลดจากเซิร์ฟเวอร์ของคุณเมื่อเปิด HiBoss"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un aviso genérico. El contenido del mensaje se carga desde tu servidor al abrir HiBoss."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य अलर्ट दिखाएँ। HiBoss खोलने पर संदेश की सामग्री आपके सर्वर से लोड होती है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض تنبيهًا عامًا. يتم تحميل محتوى الرسالة من خادمك عند فتح HiBoss."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar um alerta genérico. O conteúdo da mensagem é carregado do seu servidor quando você abre o HiBoss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une alerte générique. Le contenu du message est chargé depuis votre serveur à l’ouverture de HiBoss."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать общее оповещение. Текст сообщения загрузится с вашего сервера при открытии HiBoss."
          }
        }
      }
    },
