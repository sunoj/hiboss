            "state": "translated",
            "value": "Silencia los avisos de menor prioridad según tu horario."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शेड्यूल पर कम प्राथमिकता वाले अलर्ट शांत करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسكِت التنبيهات الأقل أولوية وفق جدولك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencie alertas de menor prioridade nos horários que você definir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupez les alertes moins prioritaires selon vos horaires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключайте звук оповещений с низким приоритетом по расписанию."
