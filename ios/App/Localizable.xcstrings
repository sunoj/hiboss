    "Only type this code on a Mac that is in front of you. Never read it out or send it to anyone, even if they ask for it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only type this code on a Mac that is in front of you. Never read it out or send it to anyone, even if they ask for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你面前的 Mac 上输入此代码。切勿念出或发送给任何人，即使对方向你索要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは目の前にある Mac にだけ入力してください。求められても、読み上げたり誰かに送ったりしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 눈앞에 있는 Mac에만 입력하세요. 누가 요청하더라도 읽어 주거나 보내지 마세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์รหัสนี้บน Mac ที่อยู่ตรงหน้าคุณเท่านั้น ห้ามอ่านออกเสียงหรือส่งให้ใคร แม้จะมีคนขอก็ตาม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe este código solo en un Mac que tengas delante. Nunca lo leas en voz alta ni se lo envíes a nadie, aunque te lo pidan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड केवल उसी Mac पर टाइप करें जो आपके सामने है। इसे कभी किसी को पढ़कर न सुनाएँ या भेजें, भले ही वे माँगें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب هذا الرمز فقط على جهاز Mac موجود أمامك. لا تقرأه بصوت عالٍ ولا ترسله إلى أي شخص، حتى لو طلبه منك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite este código somente em um Mac que esteja na sua frente. Nunca o leia em voz alta nem o envie a ninguém, mesmo que peçam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne saisissez ce code que sur un Mac qui se trouve devant vous. Ne le lisez jamais à voix haute et ne l’envoyez à personne, même si on vous le demande."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводите этот код только на Mac, который стоит перед вами. Никогда не зачитывайте и не отправляйте его никому, даже если вас об этом просят."
          }
        }
      }
    }
  },
  "version": "1.0"
}
