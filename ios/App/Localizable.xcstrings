            "value": "कोड की समय-सीमा समाप्त"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código expirado"
          }
        },
