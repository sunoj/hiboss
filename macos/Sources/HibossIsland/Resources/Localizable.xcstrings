    "That code didn't match. Check the code on your iPhone and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn't match. Check the code on your iPhone and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码不匹配。请核对 iPhone 上的验证码后重试。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสไม่ตรงกัน ตรวจสอบรหัสบน iPhone แล้วลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código no coincide. Revisa el código del iPhone y vuelve a intentarlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह कोड मेल नहीं खाया। iPhone पर कोड जाँचें और फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز غير مطابق. تحقّق من الرمز على iPhone وحاول مرة أخرى."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código não confere. Verifique o código no iPhone e tente de novo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne correspond pas. Vérifiez le code sur l’iPhone et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが一致しません。iPhoneのコードを確認して、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код не подошёл. Проверьте код на iPhone и попробуйте снова."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 일치하지 않습니다. iPhone의 코드를 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "The server is busy with sign-in requests. Try again in a few minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is busy with sign-in requests. Try again in a few minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的登录请求过多。请几分钟后再试。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์มีคำขอลงชื่อเข้ามากเกินไป ลองอีกครั้งในอีกไม่กี่นาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tiene demasiadas solicitudes de inicio de sesión. Vuelve a intentarlo en unos minutos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर पर साइन-इन अनुरोध बहुत ज़्यादा हैं। कुछ मिनट बाद फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخادم مشغول بطلبات تسجيل الدخول. حاول مرة أخرى بعد بضع دقائق."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está com muitas solicitações de entrada. Tente de novo em alguns minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur traite trop de demandes de connexion. Réessayez dans quelques minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがサインインリクエストで混み合っています。数分後にもう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер перегружен запросами на вход. Попробуйте через несколько минут."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 로그인 요청이 많습니다. 몇 분 후에 다시 시도하세요."
          }
        }
      }
    },
    "Couldn't reach the server. Check the address and your connection, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the server. Check the address and your connection, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器。请检查地址和网络连接后重试。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ ตรวจสอบที่อยู่และการเชื่อมต่อ แล้วลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor. Revisa la dirección y la conexión y vuelve a intentarlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर तक नहीं पहुँच सके। पता और कनेक्शन जाँचें, फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم. تحقّق من العنوان والاتصال، ثم حاول مرة أخرى."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor. Verifique o endereço e a conexão e tente de novo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur. Vérifiez l’adresse et la connexion, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに接続できませんでした。アドレスと接続を確認して、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сервером. Проверьте адрес и подключение и попробуйте снова."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다. 주소와 연결을 확인한 후 다시 시도하세요."
          }
        }
      }
    },
    "Sign-in declined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in declined"
          }
        },
        "zh-Hans": {
          "stringUnit": {
