    "Still waiting for the server. Your credentials are kept here. Check your connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still waiting for the server. Your credentials are kept here. Check your connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在等待服务器，连接信息已保留。请检查网络连接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの応答を待っています。認証情報はこのデバイスに保持されています。接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 서버를 기다리는 중이에요. 인증 정보는 여기에 보관돼요. 연결을 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังรอเซิร์ฟเวอร์อยู่ ข้อมูลรับรองของคุณยังเก็บไว้ที่นี่ โปรดตรวจสอบการเชื่อมต่อ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún esperando al servidor. Tus credenciales se conservan aquí. Comprueba la conexión."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी भी सर्वर का इंतज़ार है। आपके क्रेडेंशियल यहीं रखे गए हैं। अपना कनेक्शन जाँचें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال في انتظار الخادم. بيانات اعتمادك محفوظة هنا. تحقّق من اتصالك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda aguardando o servidor. Suas credenciais estão guardadas aqui. Verifique a conexão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours en attente du serveur. Vos identifiants sont conservés ici. Vérifiez votre connexion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ещё ждём сервер. Учётные данные сохранены здесь. Проверьте подключение."
          }
        }
      }
    },
