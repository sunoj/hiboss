    "A request lasts ten minutes. Start over for a new QR code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A request lasts ten minutes. Start over for a new QR code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个请求有效十分钟。重新开始以获取新的二维码。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอมีอายุสิบนาที เริ่มใหม่เพื่อรับคิวอาร์โค้ดใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una solicitud dura diez minutos. Empieza de nuevo para obtener un código QR nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अनुरोध दस मिनट तक रहता है। नया QR कोड पाने के लिए फिर से शुरू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر الطلب عشر دقائق. ابدأ من جديد للحصول على رمز QR جديد."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma solicitação dura dez minutos. Recomece para obter um novo código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande dure dix minutes. Recommencez pour obtenir un nouveau code QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストの有効期間は10分です。最初からやり直して新しいQRコードを表示してください。"
