        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट उपलब्ध नहीं हैं। आप बिना प्रोजेक्ट के सहेज सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
