    "Retry to check for unanswered questions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry to check for unanswered questions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试以检查待回答问卷。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองอีกครั้งเพื่อตรวจหาคำถามที่ยังไม่ได้ตอบ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo para buscar preguntas sin responder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुत्तरित प्रश्न जाँचने के लिए फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة للتحقق من الأسئلة غير المُجاب عنها."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente para verificar perguntas sem resposta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez pour vérifier les questions sans réponse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行して未回答のアンケートを確認してください。"
          }
        },
        "ru": {
