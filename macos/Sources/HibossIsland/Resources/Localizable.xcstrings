    "Scan this QR code with your phone to enroll it in HiBoss. The code is valid for five minutes and can be used once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this QR code with your phone to enroll it in HiBoss. The code is valid for five minutes and can be used once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手机扫描此二维码，将其添加到 HiBoss。二维码 5 分钟内有效，仅可使用一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนรหัส QR นี้ด้วยโทรศัพท์เพื่อลงทะเบียนกับ HiBoss รหัสนี้ใช้ได้ 5 นาทีและใช้ได้เพียงครั้งเดียว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código QR con tu teléfono para registrarlo en HiBoss. El código es válido durante cinco minutos y solo se puede usar una vez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ोन को HiBoss में जोड़ने के लिए इस QR कोड को स्कैन करें। कोड पाँच मिनट तक मान्य है और एक ही बार इस्तेमाल हो सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR هذا بهاتفك لتسجيله في HiBoss. الرمز صالح لمدة خمس دقائق ويمكن استخدامه مرة واحدة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie este código QR com seu celular para registrá-lo no HiBoss. O código vale por cinco minutos e só pode ser usado uma vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code QR avec votre téléphone pour l’inscrire dans HiBoss. Le code est valable cinq minutes et ne peut servir qu’une fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この QR コードをスマートフォンでスキャンして、HiBoss に登録します。コードの有効期間は5分間で、使用できるのは1回だけです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте этот QR-код телефоном, чтобы подключить его к HiBoss. Код действует пять минут и может быть использован один раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰으로 이 QR 코드를 스캔하여 HiBoss에 등록하세요. 코드는 5분 동안 유효하며 한 번만 사용할 수 있어요."
          }
        }
      }
    },
