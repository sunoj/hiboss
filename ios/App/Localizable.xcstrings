    "Everything is settled. This is where an agent's next question will appear.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is settled. This is where an agent's next question will appear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都已处理妥当。智能体的下一个问题会出现在这里。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างเรียบร้อยแล้ว คำถามถัดไปของเอเจนต์จะแสดงที่นี่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo está resuelto. Aquí aparecerá la próxima pregunta de un agente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ निपट गया है। एजेंट का अगला प्रश्न यहाँ दिखाई देगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء محسوم. سيظهر هنا سؤال الوكيل التالي."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo resolvido. A próxima pergunta de um agente aparecerá aqui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est réglé. La prochaine question d’un agent apparaîtra ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて対応済みです。エージェントからの次の質問はここに表示されます。"
          }
