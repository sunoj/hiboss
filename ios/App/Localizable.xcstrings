    "That decision was already answered elsewhere.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该决策已在其他地方答复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この判断はほかの場所で回答済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결정은 이미 다른 곳에서 답변했어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตัดสินใจนั้นถูกตอบจากที่อื่นแล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa decisión ya se respondió en otro lugar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस निर्णय का जवाब पहले ही कहीं और दिया जा चुका है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الإجابة عن هذا القرار في مكان آخر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa decisão já foi respondida em outro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette décision a déjà reçu une réponse ailleurs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На это решение уже ответили в другом месте."
          }
        }
      }
    },
    "Couldn't send your reply — check your connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送答复，请检查连接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信を送信できませんでした。接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장을 보내지 못했어요. 연결 상태를 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำตอบไม่ได้ — ตรวจสอบการเชื่อมต่อ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar tu respuesta: revisa tu conexión."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका जवाब नहीं भेजा जा सका — अपना कनेक्शन जाँचें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرسال ردك — تحقق من الاتصال."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar sua resposta — verifique a conexão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer votre réponse — vérifiez votre connexion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить ответ — проверьте подключение."
          }
        }
      }
    },
