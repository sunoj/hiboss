    "On the other iPhone, scan this code. On a Mac, paste the link into Pair with Code. The code works once and expires in five minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other iPhone, scan this code. On a Mac, paste the link into Pair with Code. The code works once and expires in five minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台 iPhone 上扫描此代码。在 Mac 上，将链接粘贴到“使用配对码配对”。该代码只能使用一次，五分钟后过期。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPhone อีกเครื่อง ให้สแกนรหัสนี้ บน Mac ให้วางลิงก์ใน จับคู่ด้วยรหัส รหัสใช้ได้ครั้งเดียวและหมดอายุใน 5 นาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el otro iPhone, escanea este código. En un Mac, pega el enlace en Vincular con código. El código funciona una vez y caduca en cinco minutos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे iPhone पर यह कोड स्कैन करें। Mac पर, लिंक को ‘कोड से पेयर करें’ में पेस्ट करें। कोड एक बार काम करता है और पाँच मिनट में समाप्त हो जाता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز iPhone الآخر، امسح هذا الرمز. على Mac، الصق الرابط في «الإقران برمز». يعمل الرمز مرة واحدة وتنتهي صلاحيته خلال خمس دقائق."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No outro iPhone, escaneie este código. Em um Mac, cole o link em Parear com código. O código funciona uma vez e expira em cinco minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’autre iPhone, scannez ce code. Sur un Mac, collez le lien dans Jumeler avec un code. Le code fonctionne une fois et expire au bout de cinq minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方の iPhone でこのコードをスキャンします。Mac では、リンクを「コードでペアリング」に貼り付けます。コードは 1 回だけ使え、5 分で期限切れになります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На другом iPhone отсканируйте этот код. На Mac вставьте ссылку в «Привязать по коду». Код действует один раз и истекает через пять минут."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 iPhone에서 이 코드를 스캔하세요. Mac에서는 링크를 ‘코드로 페어링’에 붙여 넣으세요. 코드는 한 번만 쓸 수 있고 5분 후 만료돼요."
          }
        }
      }
    },
    "Connect to a server before pairing another device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a server before pairing another device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先连接服务器，再配对其他设备。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ก่อนจับคู่อุปกรณ์อื่น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a un servidor antes de vincular otro dispositivo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा डिवाइस पेयर करने से पहले किसी सर्वर से कनेक्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بخادم قبل إقران جهاز آخر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se a um servidor antes de parear outro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à un serveur avant de jumeler un autre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスをペアリングする前にサーバに接続してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к серверу, прежде чем привязывать другое устройство."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기를 페어링하기 전에 서버에 연결하세요."
          }
        }
      }
    },
    "Show a one-time code that signs in another iPhone or Mac. No token leaves this phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a one-time code that signs in another iPhone or Mac. No token leaves this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示一次性代码，用于登录另一台 iPhone 或 Mac。Token 不会离开此手机。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงรหัสใช้ครั้งเดียวเพื่อลงชื่อเข้าใช้ iPhone หรือ Mac อีกเครื่อง โทเค็นจะไม่ออกจากโทรศัพท์เครื่องนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un código de un solo uso que inicia sesión en otro iPhone o Mac. Ningún token sale de este teléfono."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक-बार वाला कोड दिखाएँ जिससे दूसरे iPhone या Mac में साइन इन होता है। कोई टोकन इस फ़ोन से बाहर नहीं जाता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض رمزًا لمرة واحدة يسجّل الدخول على iPhone أو Mac آخر. لا يغادر أي رمز وصول هذا الهاتف."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre um código de uso único que conecta outro iPhone ou Mac. Nenhum token sai deste telefone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez un code à usage unique qui connecte un autre iPhone ou Mac. Aucun jeton ne quitte ce téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の iPhone や Mac にサインインするワンタイムコードを表示します。トークンがこの iPhone から出ることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите одноразовый код для входа на другом iPhone или Mac. Токен не покидает этот телефон."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 iPhone이나 Mac에 로그인하는 일회용 코드를 표시해요. 토큰은 이 iPhone 밖으로 나가지 않아요."
          }
        }
      }
    },
