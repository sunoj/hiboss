          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल डेमन स्ट्रीम और प्रेफ़रेंस स्टोर के लिए केवल-पढ़ने योग्य डायग्नोस्टिक्स।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
