<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
        <string>ja</string>
        <string>ko</string>
        <string>th</string>
        <string>es</string>
        <string>hi</string>
        <string>ar</string>
        <string>pt-BR</string>
        <string>fr</string>
        <string>ru</string>
    </array>
    <key>CFBundleDisplayName</key>
    <string>HiBoss Island</string>
    <key>CFBundleExecutable</key>
    <string>HibossIsland</string>
    <key>CFBundleIdentifier</key>
    <string>ai.hiboss.island</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>HiBoss Island</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- hiboss://pair?server=…&code=… opens the redeem sheet pre-filled; redeeming
         still needs a click on a confirm button that names the server host. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>ai.hiboss.island.pair</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>hiboss</string>
            </array>
        </dict>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>12</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Sparkle auto-update. The feed defaults to hiboss.org; scripts/build-app.sh
         overrides it from HIBOSS_APPCAST_URL. SUPublicEDKey is added at package time
         from HIBOSS_SPARKLE_PUBKEY and is deliberately absent here: an empty key is
         *invalid* to Sparkle (not "unset"), which makes startUpdater fail and alert
         on every launch. SparkleUpdater skips starting the updater without a key. -->
    <key>SUFeedURL</key>
    <string>https://hiboss.org/updates/macos/appcast.xml</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
