    "Not connected. Pull to refresh or reconnect in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected. Pull to refresh or reconnect in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未连接。请下拉刷新或在设置中重新连接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されていません。引き下げて更新するか、設定で再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되지 않았어요. 당겨서 새로 고치거나 설정에서 다시 연결하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้เชื่อมต่อ ดึงลงเพื่อรีเฟรชหรือเชื่อมต่อใหม่ในการตั้งค่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Desliza para actualizar o reconecta en Ajustes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट नहीं है। रीफ़्रेश करने के लिए नीचे खींचें या सेटिंग्ज़ में फिर से कनेक्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متصل. اسحب للتحديث أو أعد الاتصال من الإعدادات."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão. Puxe para atualizar ou reconecte em Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté. Tirez pour actualiser ou reconnectez-vous dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения. Потяните для обновления или переподключитесь в Настройках."
          }
        }
      }
    },
