    "On a device that is already signed in, choose Pair another device. Enter the server and the one-time code it shows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a device that is already signed in, choose Pair another device. Enter the server and the one-time code it shows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已登录的设备上选择“配对其他设备”，然后输入它显示的服务器和一次性配对码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン済みのデバイスで「別のデバイスをペアリング」を選択し、表示されたサーバーとワンタイムコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 로그인된 기기에서 ‘다른 기기 페어링’을 선택하세요. 표시되는 서버와 일회용 코드를 입력하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนอุปกรณ์ที่ลงชื่อเข้าอยู่แล้ว ให้เลือก “จับคู่อุปกรณ์อื่น” แล้วป้อนเซิร์ฟเวอร์และรหัสแบบใช้ครั้งเดียวที่แสดง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un dispositivo con la sesión ya iniciada, elige «Vincular otro dispositivo». Introduce el servidor y el código de un solo uso que muestra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस डिवाइस में पहले से साइन इन है, उस पर “दूसरा डिवाइस पेयर करें” चुनें। उसमें दिखाया गया सर्वर और एक बार का कोड डालें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز مسجّل الدخول بالفعل، اختر «إقران جهاز آخر». أدخل الخادم والرمز لمرة واحدة الذي يعرضه."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um dispositivo com sessão iniciada, escolha “Parear outro dispositivo”. Insira o servidor e o código de uso único exibidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un appareil déjà connecté, choisissez « Jumeler un autre appareil ». Saisissez le serveur et le code à usage unique affichés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве, где уже выполнен вход, выберите «Привязать ещё устройство». Введите сервер и одноразовый код, которые там показаны."
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        },
        "zh-Hans": {
