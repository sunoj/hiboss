    "The request was declined on the iPhone, or too many wrong codes were entered.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was declined on the iPhone, or too many wrong codes were entered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求已在 iPhone 上被拒绝，或输错验证码的次数过多。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอถูกปฏิเสธบน iPhone หรือป้อนรหัสผิดหลายครั้งเกินไป"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud se rechazó en el iPhone o se introdujeron demasiados códigos incorrectos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध iPhone पर अस्वीकार किया गया, या बहुत बार गलत कोड डाले गए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الطلب على iPhone، أو أُدخلت رموز خاطئة مرات كثيرة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação foi recusada no iPhone ou foram digitados códigos errados demais."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande a été refusée sur l’iPhone, ou trop de codes erronés ont été saisis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでリクエストが拒否されたか、間違ったコードが何度も入力されました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос отклонён на iPhone или введено слишком много неверных кодов."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 요청이 거부되었거나 잘못된 코드가 너무 많이 입력되었습니다."
          }
        }
      }
    },
