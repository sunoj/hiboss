    "That pairing code is no longer valid. Scan again to try another code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pairing code is no longer valid. Scan again to try another code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该配对码已失效，请重新扫描其他配对码。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสจับคู่นี้ใช้ไม่ได้แล้ว สแกนอีกครั้งเพื่อลองใช้รหัสอื่น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código de vinculación ya no es válido. Vuelve a escanear para probar con otro código."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पेयरिंग कोड अब मान्य नहीं है। दूसरा कोड आज़माने के लिए फिर से स्कैन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد رمز الإقران هذا صالحًا. امسح مجددًا لتجربة رمز آخر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código de pareamento não é mais válido. Escaneie novamente para tentar outro código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code de jumelage n’est plus valide. Scannez à nouveau pour essayer un autre code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードは無効になりました。もう一度スキャンして、別のコードをお試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код привязки больше недействителен. Отсканируйте другой код."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페어링 코드는 더 이상 유효하지 않아요. 다시 스캔하여 다른 코드로 시도하세요."
          }
        }
      }
    },
    "Couldn’t redeem the pairing code. Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t redeem the pairing code. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用该配对码，请检查连接后重试。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รหัสจับคู่ไม่สำเร็จ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo canjear el código de vinculación. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयरिंग कोड इस्तेमाल नहीं किया जा सका। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر استخدام رمز الإقران. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar o código de pareamento. Verifique sua conexão e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’utiliser le code de jumelage. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードを使用できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось использовать код привязки. Проверьте подключение и повторите попытку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
