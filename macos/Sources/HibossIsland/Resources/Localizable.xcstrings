    "Updates are delivered via Sparkle and verified with an EdDSA signature before installing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新通过 Sparkle 分发，安装前用 EdDSA 签名校验。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートは Sparkle で配信され、インストール前に EdDSA 署名で検証されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "업데이트는 Sparkle로 전달되며 설치 전 EdDSA 서명으로 검증됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตจะส่งผ่าน Sparkle และตรวจสอบด้วยลายเซ็น EdDSA ก่อนติดตั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones se distribuyen mediante Sparkle y se verifican con una firma EdDSA antes de instalarse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट Sparkle के ज़रिए भेजे जाते हैं और इंस्टॉल से पहले EdDSA हस्ताक्षर से सत्यापित होते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسلَّم التحديثات عبر Sparkle ويُتحقَّق منها بتوقيع EdDSA قبل التثبيت."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações são distribuídas pelo Sparkle e verificadas com assinatura EdDSA antes da instalação."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour sont distribuées via Sparkle et vérifiées par une signature EdDSA avant l’installation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновления доставляются через Sparkle и перед установкой проверяются подписью EdDSA."
          }
        }
      }
    },
    "This build has no update feed configured, so it will not check for updates.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建未配置更新源，因此不会检查更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはアップデートフィードが設定されていないため、アップデートは確認されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 빌드에는 업데이트 피드가 없어 업데이트를 확인하지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิลด์นี้ไม่ได้กำหนดค่าฟีดอัปเดตไว้ จึงจะไม่ตรวจหาอัปเดต"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no tiene una fuente de actualizaciones configurada, así que no buscará actualizaciones."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिल्ड में कोई अपडेट फ़ीड कॉन्फ़िगर नहीं है, इसलिए यह अपडेट नहीं जाँचेगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الإصدار على مصدر تحديثات مُهيّأ، لذا لن يتحقق من التحديثات."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação não tem um feed de atualizações configurado, então não buscará atualizações."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun flux de mises à jour n’est configuré pour ce build ; il ne recherchera donc pas de mises à jour."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой сборке не настроен источник обновлений, поэтому проверка обновлений отключена."
          }
        }
      }
    },
