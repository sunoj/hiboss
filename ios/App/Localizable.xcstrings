          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بخادم قبل تسجيل الدخول على Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se a um servidor antes de iniciar sessão em um Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à un serveur avant de connecter un Mac."
          }
