    "Use a pairing code from your Mac, or enter a server URL and Boss Token.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a pairing code from your Mac, or enter a server URL and Boss Token."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Mac 上的配对码，或输入服务器地址和 Boss Token。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รหัสจับคู่จาก Mac ของคุณ หรือป้อน URL เซิร์ฟเวอร์และ Boss Token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un código de vinculación de tu Mac o introduce una URL de servidor y un Boss Token."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac से पेयरिंग कोड इस्तेमाल करें, या सर्वर URL और Boss Token दर्ज करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم رمز إقران من جهاز Mac، أو أدخل عنوان الخادم و Boss Token."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um código de pareamento do seu Mac ou insira a URL do servidor e um Boss Token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un code de jumelage de votre Mac, ou saisissez l’URL d’un serveur et un Boss Token."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
