{
  "sourceLanguage": "en",
  "strings": {
    "Drop up to 4 items at a time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop up to 4 items at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多拖入 4 项。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางได้ครั้งละไม่เกิน 4 รายการ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra hasta 4 elementos a la vez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार में अधिकतम 4 आइटम छोड़ें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلت حتى 4 عناصر في المرة الواحدة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte até 4 itens por vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez jusqu’à 4 éléments à la fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度にドロップできるのは4項目までです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите не более 4 элементов за раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 최대 4개 항목을 놓으세요."
          }
        }
      }
    },
    "Drop a file, image, text or web URL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a file, image, text or web URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入文件、图片、文本或网页链接。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางไฟล์ รูปภาพ ข้อความ หรือ URL ของเว็บ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un archivo, imagen, texto o URL web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल, चित्र, टेक्स्ट या वेब URL छोड़ें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلت ملفًا أو صورة أو نصًا أو رابط ويب."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte um arquivo, imagem, texto ou URL da web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un fichier, une image, du texte ou une URL web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル、画像、テキスト、またはウェブURLをドロップしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите файл, изображение, текст или веб-ссылку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일, 이미지, 텍스트 또는 웹 URL을 놓으세요."
          }
        }
      }
    },
    "Images must be 10 MB or smaller. Nothing was uploaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images must be 10 MB or smaller. Nothing was uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片不得超过 10 MB。未上传任何内容。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพต้องไม่เกิน 10 MB ยังไม่มีการอัปโหลด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes no deben superar 10 MB. No se subió nada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र 10 MB या उससे छोटे होने चाहिए। कुछ भी अपलोड नहीं हुआ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا تتجاوز الصور 10 MB. لم يتم رفع أي شيء."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens devem ter até 10 MB. Nada foi enviado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images doivent faire 10 Mo maximum. Aucun envoi effectué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は10 MB以下にしてください。何もアップロードされていません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения должны быть не более 10 МБ. Ничего не загружено."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지는 10 MB 이하여야 합니다. 아무것도 업로드되지 않았습니다."
          }
        }
      }
    },
    "Videos and files must be 50 MB or smaller. Nothing was uploaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos and files must be 50 MB or smaller. Nothing was uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频和文件不得超过 50 MB。未上传任何内容。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอและไฟล์ต้องไม่เกิน 50 MB ยังไม่มีการอัปโหลด"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los videos y archivos no deben superar 50 MB. No se subió nada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो और फ़ाइलें 50 MB या उससे छोटी होनी चाहिए। कुछ भी अपलोड नहीं हुआ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا تتجاوز الفيديوهات والملفات 50 MB. لم يتم رفع أي شيء."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos e arquivos devem ter até 50 MB. Nada foi enviado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos et fichiers doivent faire 50 Mo maximum. Aucun envoi effectué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画とファイルは50 MB以下にしてください。何もアップロードされていません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео и файлы должны быть не более 50 МБ. Ничего не загружено."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상과 파일은 50 MB 이하여야 합니다. 아무것도 업로드되지 않았습니다."
          }
        }
      }
    },
