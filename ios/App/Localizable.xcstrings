        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर तक नहीं पहुँच सके।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم."
          }
        },
        "pt-BR": {
