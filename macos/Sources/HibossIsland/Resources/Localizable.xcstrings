          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데몬 스트림과 환경설정 저장소의 읽기 전용 진단이에요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวินิจฉัยแบบอ่านอย่างเดียวสำหรับสตรีมของเดมอนในเครื่องและที่เก็บการตั้งค่า"
          }
        },
        "es": {
          "stringUnit": {
