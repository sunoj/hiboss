    "Message notifications do not apply quiet hours or priority filtering.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message notifications do not apply quiet hours or priority filtering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息通知不应用免打扰时段或优先级筛选。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนข้อความไม่ใช้ช่วงห้ามรบกวนหรือการกรองตามลำดับความสำคัญ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de mensajes no aplican las horas de silencio ni el filtro por prioridad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश सूचनाओं पर शांत समय या प्राथमिकता फ़िल्टर लागू नहीं होते।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تطبّق إشعارات الرسائل ساعات عدم الإزعاج ولا تصفية الأولوية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações de mensagens não aplicam o horário de silêncio nem o filtro de prioridade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de messages ne tiennent pas compte des heures de silence ni du filtrage par priorité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージの通知には、おやすみ時間や優先度による絞り込みは適用されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К уведомлениям о сообщениях не применяются тихие часы и фильтр по приоритету."
          }
        }
      }
    },
    "Automatic": {
