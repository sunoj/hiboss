          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona los dispositivos conectados a tu cuenta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने खाते से जुड़े डिवाइस प्रबंधित करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدارة الأجهزة المتصلة بحسابك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie os dispositivos conectados à sua conta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les appareils connectés à votre compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントに接続されているデバイスを管理します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте устройствами, подключёнными к вашей учётной записи."
          }
        }
      }
    },
