    "Machines that run hiboss setup with an invite wait here until an admin approves them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Machines that run hiboss setup with an invite wait here until an admin approves them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用邀请运行 hiboss setup 的机器会在这里等待，直到管理员批准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待を使って hiboss setup を実行したマシンは、管理者が承認するまでここで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대로 hiboss setup을 실행한 머신은 관리자가 승인할 때까지 여기에서 대기합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องที่รัน hiboss setup ด้วยคำเชิญจะรออยู่ที่นี่จนกว่าผู้ดูแลระบบจะอนุมัติ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las máquinas que ejecutan hiboss setup con una invitación esperan aquí hasta que un administrador las apruebe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो मशीनें आमंत्रण के साथ hiboss setup चलाती हैं, वे एडमिन की स्वीकृति तक यहां प्रतीक्षा करती हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتظر هنا الأجهزة التي تشغّل hiboss setup باستخدام دعوة حتى يوافق عليها المسؤول."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máquinas que executam hiboss setup com um convite aguardam aqui até que um administrador as aprove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les machines qui exécutent hiboss setup avec une invitation attendent ici qu’un administrateur les approuve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машины, выполнившие hiboss setup с приглашением, ждут здесь одобрения администратора."
          }
        }
      }
    },
