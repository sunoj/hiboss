    "Projects unavailable. You can save without a project.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects unavailable. You can save without a project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载项目。可以不选项目直接保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトを読み込めません。選択せずに保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트를 불러올 수 없습니다. 선택하지 않고 저장할 수 있습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดโปรเจกต์ไม่ได้ คุณบันทึกโดยไม่เลือกโปรเจกต์ได้"
          }
