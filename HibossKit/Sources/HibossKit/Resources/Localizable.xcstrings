{
  "sourceLanguage": "en",
  "strings": {
    "The server returned an invalid response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了无效响应。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サーバーから無効な応答が返されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "서버가 잘못된 응답을 반환했습니다."
          }
        }
      }
    },
    "That Boss Token was rejected. Check the token and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Boss Token 被拒绝。请检查令牌后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boss Token が拒否されました。トークンを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boss Token이 거부되었습니다. 토큰을 확인한 뒤 다시 시도하세요."
          }
        }
      }
    },
    "Server request failed (HTTP %lld).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器请求失败（HTTP %lld）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サーバーリクエストが失敗しました（HTTP %lld）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "서버 요청이 실패했습니다(HTTP %lld)."
          }
        }
      }
    },
    "Couldn't read %@. Server sent: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %@。服务器返回：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ を読み取れませんでした。サーバー応答: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@을(를) 읽을 수 없습니다. 서버 응답: %@"
          }
        }
      }
    },
    "Enter a valid HTTP or HTTPS server URL.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 HTTP 或 HTTPS 服务器地址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有効な HTTP または HTTPS のサーバー URL を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "유효한 HTTP 또는 HTTPS 서버 URL을 입력하세요."
          }
        }
      }
    },
    "Enter a Boss Token.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 Boss Token。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boss Token を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Boss Token을 입력하세요."
          }
        }
      }
    },
    "Keychain operation failed (%lld).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钥匙串操作失败（%lld）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キーチェーン操作に失敗しました（%lld）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키체인 작업이 실패했습니다(%lld)."
          }
        }
      }
    },
