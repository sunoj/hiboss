            "state": "translated",
            "value": " HTTP simples funciona apenas para localhost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Le HTTP simple ne fonctionne que pour localhost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Обычный HTTP работает только для localhost."
          }
        }
      }
    },
    "Decisions can alert at normal priority, including on the lock screen and Dynamic Island.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decisions can alert at normal priority, including on the lock screen and Dynamic Island."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通优先级的待决策事项也可提醒你，包括在锁屏和灵动岛上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断は通常の優先度で通知でき、ロック画面や Dynamic Island にも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정은 보통 우선순위로 알림을 보낼 수 있으며 잠금 화면과 Dynamic Island에도 표시돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตัดสินใจสามารถแจ้งเตือนที่ลำดับความสำคัญปกติได้ รวมถึงบนหน้าจอล็อกและ Dynamic Island"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las decisiones pueden avisar con prioridad normal, también en la pantalla de bloqueo y la Dynamic Island."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्णय सामान्य प्राथमिकता पर अलर्ट कर सकते हैं, लॉक स्क्रीन और Dynamic Island पर भी।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للقرارات التنبيه بأولوية عادية، بما في ذلك على شاشة القفل وDynamic Island."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As decisões podem alertar com prioridade normal, inclusive na Tela Bloqueada e na Dynamic Island."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les décisions peuvent alerter en priorité normale, y compris sur l’écran verrouillé et dans la Dynamic Island."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решения могут оповещать с обычным приоритетом, в том числе на экране блокировки и в Dynamic Island."
          }
        }
      }
    },
    "Choose delivery, sound and immediate attention for each priority.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose delivery, sound and immediate attention for each priority."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择各优先级的送达方式、声音和即时提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先度ごとに配信方法、サウンド、即時通知を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우선순위별로 전달 방식, 사운드, 즉시 알림을 선택하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกการส่ง เสียง และการแจ้งเตือนทันทีสำหรับแต่ละลำดับความสำคัญ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la entrega, el sonido y la atención inmediata para cada prioridad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्राथमिकता के लिए डिलीवरी, ध्वनि और तुरंत ध्यान चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر طريقة التسليم والصوت والتنبيه الفوري لكل أولوية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a entrega, o som e a atenção imediata para cada prioridade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la distribution, le son et l’alerte immédiate pour chaque priorité."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите способ доставки, звук и срочность для каждого приоритета."
          }
        }
      }
    },
    "New machines appear here when they ask to join.": {
