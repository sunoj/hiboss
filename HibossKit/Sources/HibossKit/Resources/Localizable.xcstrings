    "This questionnaire changed. Your previous draft is preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问卷已更新，之前的草稿已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアンケートは変更されました。以前の下書きは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설문이 변경되었어요. 이전 임시 저장본은 보관되어 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบสอบถามนี้มีการเปลี่ยนแปลง แบบร่างก่อนหน้าของคุณยังถูกเก็บไว้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cuestionario cambió. Tu borrador anterior se conservó."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रश्नावली बदल गई है। आपका पिछला ड्राफ़्ट सुरक्षित है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر هذا الاستبيان. تم الاحتفاظ بمسودتك السابقة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este questionário mudou. Seu rascunho anterior foi mantido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce questionnaire a changé. Votre brouillon précédent est conservé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анкета изменилась. Предыдущий черновик сохранён."
          }
        }
      }
