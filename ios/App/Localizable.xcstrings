    "The iPhone app connects only over HTTPS. Use your server's https:// address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone app connects only over HTTPS. Use your server's https:// address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 应用只能通过 HTTPS 连接。请使用服务器的 https:// 地址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone アプリは HTTPS でのみ接続します。サーバーの https:// アドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 앱은 HTTPS로만 연결돼요. 서버의 https:// 주소를 사용하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปบน iPhone เชื่อมต่อผ่าน HTTPS เท่านั้น โปรดใช้ที่อยู่ https:// ของเซิร์ฟเวอร์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de iPhone solo se conecta mediante HTTPS. Usa la dirección https:// de tu servidor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ऐप केवल HTTPS पर कनेक्ट होता है। अपने सर्वर का https:// पता इस्तेमाल करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل تطبيق iPhone عبر HTTPS فقط. استخدم عنوان https:// لخادمك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app para iPhone se conecta somente via HTTPS. Use o endereço https:// do seu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app iPhone se connecte uniquement en HTTPS. Utilisez l’adresse https:// de votre serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение для iPhone подключается только по HTTPS. Используйте адрес сервера https://."
          }
        }
      }
    },
    "This video format cannot be played. You can share the original file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video format cannot be played. You can share the original file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法播放此视频格式。你可以分享原始文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画形式は再生できません。元のファイルを共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상 형식은 재생할 수 없어요. 원본 파일을 공유할 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเล่นวิดีโอรูปแบบนี้ได้ คุณสามารถแชร์ไฟล์ต้นฉบับได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de vídeo no se puede reproducir. Puedes compartir el archivo original."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वीडियो फ़ॉर्मेट चलाया नहीं जा सकता। आप मूल फ़ाइल शेयर कर सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تشغيل تنسيق الفيديو هذا. يمكنك مشاركة الملف الأصلي."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de vídeo não pode ser reproduzido. Você pode compartilhar o arquivo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format vidéo ne peut pas être lu. Vous pouvez partager le fichier d’origine."
          }
        },
        "ru": {
          "stringUnit": {
