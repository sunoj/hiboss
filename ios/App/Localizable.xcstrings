    "This is taking longer than usual. You can retry or cancel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is taking longer than usual. You can retry or cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耗时比平时更长。可以重试或取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常より時間がかかっています。再試行またはキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소보다 오래 걸리고 있습니다. 재시도하거나 취소할 수 있습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เวลานานกว่าปกติ คุณลองใหม่หรือยกเลิกได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tardando más de lo habitual. Puedes reintentar o cancelar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें सामान्य से अधिक समय लग रहा है। फिर से कोशिश करें या रद्द करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق هذا وقتًا أطول من المعتاد. يمكنك إعادة المحاولة أو الإلغاء."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está demorando mais que o normal. Você pode tentar novamente ou cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela prend plus de temps que prévu. Réessayez ou annulez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это занимает больше времени. Можно повторить или отменить."
          }
        }
      }
    },
    "Share a file, link, text, image, or video.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a file, link, text, image, or video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请分享文件、链接、文本、图片或视频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル、リンク、テキスト、画像、動画を共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일, 링크, 텍스트, 이미지 또는 동영상을 공유하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ไฟล์ ลิงก์ ข้อความ รูปภาพ หรือวิดีโอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un archivo, enlace, texto, imagen o vídeo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल, लिंक, टेक्स्ट, चित्र या वीडियो शेयर करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك ملفًا أو رابطًا أو نصًا أو صورة أو فيديو."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe um arquivo, link, texto, imagem ou vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez un fichier, un lien, un texte, une image ou une vidéo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь файлом, ссылкой, текстом, изображением или видео."
          }
        }
      }
    },
    "Share up to 4 attachments at a time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share up to 4 attachments at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次最多分享 4 个附件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に共有できる添付ファイルは4件までです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 최대 4개의 첨부 파일을 공유하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ไฟล์แนบได้ครั้งละไม่เกิน 4 ไฟล์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte hasta 4 adjuntos a la vez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार में अधिकतम 4 अटैचमेंट शेयर करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك حتى 4 مرفقات في المرة الواحدة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe até 4 anexos por vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez jusqu’à 4 pièces jointes à la fois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте не более 4 вложений за раз."
          }
        }
      }
    },
    "This image cannot fit within 10 MB. Choose a smaller image.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image cannot fit within 10 MB. Choose a smaller image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片无法压缩到 10 MB 以内。请选择较小的图片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を10 MB以下にできません。小さい画像を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지를 10 MB 이하로 줄일 수 없습니다. 더 작은 이미지를 선택하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดรูปภาพนี้ให้ไม่เกิน 10 MB ไม่ได้ โปรดเลือกรูปภาพที่เล็กกว่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen supera 10 MB. Elige una imagen más pequeña."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चित्र को 10 MB के भीतर नहीं किया जा सकता। छोटा चित्र चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تقليل هذه الصورة إلى 10 MB. اختر صورة أصغر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível reduzir esta imagem a 10 MB. Escolha uma imagem menor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image ne peut pas tenir dans 10 MB. Choisissez une image plus petite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось уменьшить изображение до 10 MB. Выберите изображение поменьше."
          }
        }
      }
    },
    "This video is still over 50 MB. Trim the clip and share it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video is still over 50 MB. Trim the clip and share it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视频仍超过 50 MB。请裁剪后重新分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画がまだ50 MBを超えています。短くして再度共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상은 여전히 50 MB를 초과합니다. 잘라낸 후 다시 공유하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอยังเกิน 50 MB โปรดตัดคลิปแล้วแชร์อีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo aún supera 50 MB. Recórtalo y vuelve a compartirlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वीडियो अभी भी 50 MB से बड़ा है। क्लिप काटकर फिर शेयर करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال الفيديو أكبر من 50 MB. قص المقطع وشاركه مجددًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vídeo ainda supera 50 MB. Corte o clipe e compartilhe novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vidéo dépasse encore 50 MB. Raccourcissez-la et partagez-la à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео всё ещё больше 50 MB. Обрежьте ролик и отправьте снова."
          }
        }
      }
    },
    "This text or note is too long. Keep it within 16 KB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text or note is too long. Keep it within 16 KB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本或备注过长。请保持在 16 KB 以内。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストまたはメモが長すぎます。16 KB以内にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 또는 메모가 너무 깁니다. 16 KB 이하로 줄이세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความหรือบันทึกยาวเกินไป โปรดให้ไม่เกิน 16 KB"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto o la nota es demasiado largo. Limítalo a 16 KB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट या नोट बहुत लंबा है। इसे 16 KB के भीतर रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص أو الملاحظة طويل جدًا. اجعله ضمن 16 KB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto ou a nota é muito longo. Limite a 16 KB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte ou la note est trop long. Limitez-le à 16 KB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст или заметка слишком длинные. Сократите до 16 KB."
          }
        }
      }
    },
    "Could not prepare this attachment. Try sharing it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare this attachment. Try sharing it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法处理此附件。请重新分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルを準備できませんでした。もう一度共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일을 준비할 수 없습니다. 다시 공유해 주세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตรียมไฟล์แนบนี้ไม่ได้ โปรดลองแชร์อีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar el adjunto. Vuelve a compartirlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अटैचमेंट तैयार नहीं हो सका। फिर से शेयर करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تجهيز هذا المرفق. حاول مشاركته مجددًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar o anexo. Compartilhe novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer cette pièce jointe. Partagez-la à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить вложение. Попробуйте отправить снова."
          }
        }
      }
    },
    "Could not save to Box. Check your connection and retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save to Box. Check your connection and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存到 Box。请检查连接后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Box に保存できませんでした。接続を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Box에 저장할 수 없습니다. 연결을 확인하고 재시도하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไปยัง Box ไม่ได้ โปรดตรวจสอบการเชื่อมต่อแล้วลองใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar en Box. Comprueba la conexión y reintenta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Box में सहेजा नहीं जा सका। कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحفظ في Box. تحقق من الاتصال وأعد المحاولة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar no Box. Verifique a conexão e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer dans Box. Vérifiez la connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить в Box. Проверьте соединение и повторите."
          }
        }
      }
    },
