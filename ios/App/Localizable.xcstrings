    "No agent message yet. Reply will be available when one arrives.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agent message yet. Reply will be available when one arrives."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无智能体消息。收到消息后即可回复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのメッセージはまだありません。メッセージが届くと返信できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 에이전트 메시지가 없어요. 메시지가 도착하면 답장할 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีข้อความจากเอเจนต์ จะตอบกลับได้เมื่อมีข้อความเข้ามา"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay mensajes de agentes. Podrás responder cuando llegue uno."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई एजेंट संदेश नहीं है। संदेश आने पर जवाब दे सकेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد رسالة وكيل بعد. سيتوفر الرد عند وصول رسالة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há mensagem de agente. A resposta ficará disponível quando uma chegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun message d’agent pour le moment. Vous pourrez répondre dès qu’un message arrivera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщений агента пока нет. Ответить можно будет, когда оно придёт."
          }
        }
      }
    },
