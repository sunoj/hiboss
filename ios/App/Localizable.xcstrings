          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter de HiBoss ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss से साइन आउट करें?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss からサインアウトしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss에서 로그아웃할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair do HiBoss?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти из HiBoss?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากระบบ HiBoss ใช่ไหม"
          }
        },
