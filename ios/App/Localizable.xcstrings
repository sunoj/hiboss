    "This sign-in request no longer exists. Start again on the Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sign-in request no longer exists. Start again on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此登录请求已不存在。请在 Mac 上重新开始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサインインリクエストはもう存在しません。Mac でもう一度始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그인 요청은 더 이상 존재하지 않습니다. Mac에서 다시 시작하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอลงชื่อเข้าใช้นี้ไม่มีอยู่แล้ว เริ่มใหม่บน Mac"
          }
        },
        "es": {
