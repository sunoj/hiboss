    "Scan the code a Mac shows under Sign in with iPhone, then type the code this iPhone shows on the Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code a Mac shows under Sign in with iPhone, then type the code this iPhone shows on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Mac 在“使用 iPhone 登录”中显示的代码，然后在 Mac 上输入这台 iPhone 显示的代码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の「iPhone でサインイン」に表示されたコードをスキャンし、この iPhone に表示されたコードを Mac に入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 'iPhone으로 로그인'에 표시된 코드를 스캔한 다음, 이 iPhone에 표시된 코드를 Mac에 입력하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนรหัสที่ Mac แสดงใน “ลงชื่อเข้าใช้ด้วย iPhone” แล้วพิมพ์รหัสที่ iPhone เครื่องนี้แสดงบน Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código que muestra un Mac en Iniciar sesión con iPhone y escribe en el Mac el código que muestra este iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac पर ‘iPhone से साइन इन करें’ में दिखा कोड स्कैन करें, फिर इस iPhone पर दिखा कोड Mac पर टाइप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الرمز الذي يعرضه جهاز Mac ضمن «تسجيل الدخول باستخدام iPhone»، ثم اكتب على Mac الرمز الذي يعرضه هذا الـ iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código que um Mac mostra em Iniciar sessão com iPhone e digite no Mac o código que este iPhone mostra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code qu’un Mac affiche sous Se connecter avec l’iPhone, puis saisissez sur le Mac le code affiché par cet iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте код, который Mac показывает в «Войти с iPhone», затем введите на Mac код, показанный этим iPhone."
          }
        }
      }
    },
    "Connect to a server before signing in a Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a server before signing in a Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先连接服务器，再登录 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
