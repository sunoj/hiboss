    "Couldn't check all requests. %@ Pull to refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check all requests. %@ Pull to refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查全部请求。%@ 下拉即可刷新。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบคำขอได้ไม่ครบ %@ ดึงลงเพื่อรีเฟรช"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron revisar todas las solicitudes. %@ Desliza hacia abajo para actualizar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी अनुरोध जाँचे नहीं जा सके। %@ रीफ़्रेश करने के लिए नीचे खींचें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من كل الطلبات. %@ اسحب للتحديث."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar todas as solicitações. %@ Puxe para atualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier toutes les demandes. %@ Tirez pour actualiser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のリクエストを確認できませんでした。%@ 下にスワイプして更新してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить все запросы. %@ Потяните вниз, чтобы обновить."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 요청을 확인할 수 없어요. %@ 아래로 당겨서 새로 고치세요."
          }
        }
      }
    },
    "This panel isn't available yet. Pull to refresh and try again.": {
