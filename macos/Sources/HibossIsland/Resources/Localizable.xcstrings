    "Read-only diagnostics for the local daemon stream and preference store.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地守护进程数据流和偏好存储的只读诊断。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
