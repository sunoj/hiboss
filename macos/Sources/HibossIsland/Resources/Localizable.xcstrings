    "Form edited since submission; this is the previous answer, not the current draft.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form edited since submission; this is the previous answer, not the current draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表单在提交后已修改；这是之前的答案，不是当前草稿。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฟอร์มถูกแก้ไขหลังส่งแล้ว นี่คือคำตอบก่อนหน้า ไม่ใช่แบบร่างปัจจุบัน"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formulario se editó después del envío; esta es la respuesta anterior, no el borrador actual."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबमिशन के बाद फ़ॉर्म बदला गया है; यह पिछला जवाब है, मौजूदा ड्राफ़्ट नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُدِّل النموذج منذ الإرسال؛ هذه هي الإجابة السابقة، وليست المسودة الحالية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formulário foi editado após o envio; esta é a resposta anterior, não o rascunho atual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formulaire modifié depuis l’envoi ; ceci est la réponse précédente, pas le brouillon actuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信後にフォームが編集されました。これは以前の回答で、現在の下書きではありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма изменена после отправки: это прежний ответ, а не текущий черновик."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출한 후에 양식이 수정되었어요. 이 내용은 현재 임시 저장본이 아닌 이전 답변이에요."
          }
        }
      }
    },
