name = "hiboss-server"
main = "src/index.ts"
compatibility_date = "2025-01-01"

[[d1_databases]]
binding = "DB"
database_name = "hiboss-db"
database_id = "<your-d1-database-id>"

[[r2_buckets]]
binding = "ATTACHMENTS"
bucket_name = "hiboss-attachments"

[[rules]]
type = "Text"
globs = ["**/*.html"]

[durable_objects]
bindings = [
  { name = "DISCORD_GATEWAY", class_name = "DiscordGateway" }
]

[[migrations]]
tag = "v1"
new_classes = ["DiscordGateway"]

[triggers]
crons = ["*/5 * * * *"]

[vars]
# Web console origin allowed by CORS (exact host + its preview subdomains).
# Leave unset to allow only localhost dev origins.
CONSOLE_ORIGIN = "https://your-console.pages.dev"

# Secrets (set with `wrangler secret put <NAME>`, never in this file):
#   BOOTSTRAP_SECRET        gates POST /api/bootstrap
#   DISCORD_WEBHOOK_SECRET  X-Webhook-Secret for POST /api/webhooks/discord
#   TELEGRAM_WEBHOOK_SECRET X-Telegram-Bot-Api-Secret-Token for the TG webhook
#   RELEASE_UPLOAD_SECRET   Bearer token for PUT /updates/macos/* (macOS Sparkle release upload)
