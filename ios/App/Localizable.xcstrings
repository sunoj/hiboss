    "Delete this collection? Items stay in the Box.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this collection? Items stay in the Box."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此集合？内容将保留在盒子中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコレクションを削除しますか？項目はボックスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컬렉션을 삭제할까요? 항목은 보관함에 남아 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคอลเลกชันนี้ใช่ไหม รายการจะยังอยู่ในกล่อง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta colección? Los elementos se quedan en la Caja."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह संग्रह हटाएँ? आइटम बॉक्स में बने रहेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف هذه المجموعة؟ تبقى العناصر في الصندوق."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir esta coleção? Os itens continuam na Caixa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette collection ? Les éléments restent dans la Boîte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить эту коллекцию? Объекты останутся в Коробке."
          }
        }
      }
    },
