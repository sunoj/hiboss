    "Startup behaviour for this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的启动行为。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac の起動時の動作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac의 시작 동작."
          }
        }
      }
    },
    "Connect this Mac to the boss daemon.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这台 Mac 连接到 boss 守护进程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac を boss デーモンに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac을 boss 데몬에 연결합니다."
          }
        }
      }
    },
    "Choose how questions surface on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择问题在这台 Mac 上如何出现。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この Mac で質問をどう表示するか選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 Mac에서 질문이 나타나는 방식을 선택합니다."
          }
        }
      }
    },
    "Route each priority to server-backed channels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将各优先级路由到服务器渠道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "各優先度をサーバー側チャネルへルーティングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "우선순위를 서버 채널로 라우팅합니다."
          }
        }
      }
    },
    "Silence lower-priority alerts on your schedule.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的日程静音较低优先级提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "スケジュールに合わせて低優先度の通知を消音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "일정에 따라 낮은 우선순위 알림을 음소거합니다."
          }
        }
      }
    },
    "Tune the local option surface and sounds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整本地选项界面和声音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ローカルの選択肢 UI とサウンドを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로컬 옵션 화면과 소리를 조정합니다."
          }
        }
      }
    },
    "Inspect daemon, stream, and preference health.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看守护进程、数据流和偏好设置健康状况。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デーモン、ストリーム、環境設定の状態を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "데몬, 스트림, 환경설정 상태를 확인합니다."
          }
        }
      }
    },
    "Version and project information.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本与项目信息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "バージョンとプロジェクト情報。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "버전 및 프로젝트 정보."
          }
        }
      }
    },
    "Enter a valid %@ time as HH:mm.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的%@时间（HH:mm）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有効な%@時刻を HH:mm で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "유효한 %@ 시간을 HH:mm으로 입력하세요."
          }
        }
      }
    },
