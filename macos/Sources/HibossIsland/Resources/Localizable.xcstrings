    "Silence lower-priority alerts on your schedule.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的日程静音较低优先级提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールに合わせて、優先度の低い通知を停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정에 따라 우선순위가 낮은 알림을 꺼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดเสียงการแจ้งเตือนที่มีลำดับความสำคัญต่ำกว่าตามกำหนดเวลาของคุณ"
          }
        },
        "es": {
