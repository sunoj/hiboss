        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти с помощью iPhone…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone으로 로그인…"
          }
        }
      }
    },
    "Show a QR code here, approve it in HiBoss on a signed-in iPhone, then type the code the iPhone shows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a QR code here, approve it in HiBoss on a signed-in iPhone, then type the code the iPhone shows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此显示二维码，在已登录的 iPhone 上用 HiBoss 批准，然后输入 iPhone 显示的验证码。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคิวอาร์โค้ดที่นี่ อนุมัติใน HiBoss บน iPhone ที่ลงชื่อเข้าแล้ว จากนั้นพิมพ์รหัสที่ iPhone แสดง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra aquí un código QR, apruébalo en HiBoss en un iPhone con la sesión iniciada y escribe el código que muestre el iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ एक QR कोड दिखाएँ, साइन इन किए हुए iPhone पर HiBoss में उसे स्वीकृत करें, फिर iPhone पर दिखा कोड टाइप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض رمز QR هنا، ووافق عليه في HiBoss على iPhone مسجَّل الدخول، ثم اكتب الرمز الذي يعرضه iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre um código QR aqui, aprove no HiBoss em um iPhone conectado e digite o código que o iPhone mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez un code QR ici, approuvez-le dans HiBoss sur un iPhone connecté, puis saisissez le code affiché par l’iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにQRコードを表示し、サインイン済みのiPhoneのHiBossで承認してから、iPhoneに表示されたコードを入力します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите здесь QR-код, одобрите его в HiBoss на iPhone, где выполнен вход, затем введите код, который покажет iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 QR 코드를 표시하고 로그인된 iPhone의 HiBoss에서 승인한 다음 iPhone에 표시된 코드를 입력하세요."
          }
        }
      }
    },
    "This Mac shows a QR code. Scan it with HiBoss on a signed-in iPhone to approve this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac shows a QR code. Scan it with HiBoss on a signed-in iPhone to approve this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 会显示一个二维码。用已登录 iPhone 上的 HiBoss 扫描它，即可批准这台 Mac。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้จะแสดงคิวอาร์โค้ด สแกนด้วย HiBoss บน iPhone ที่ลงชื่อเข้าแล้วเพื่ออนุมัติ Mac เครื่องนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac muestra un código QR. Escanéalo con HiBoss en un iPhone con la sesión iniciada para aprobar este Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac एक QR कोड दिखाता है। इस Mac को स्वीकृत करने के लिए साइन इन किए हुए iPhone पर HiBoss से उसे स्कैन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض جهاز Mac هذا رمز QR. امسحه باستخدام HiBoss على iPhone مسجَّل الدخول للموافقة على جهاز Mac هذا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac mostra um código QR. Escaneie com o HiBoss em um iPhone conectado para aprovar este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac affiche un code QR. Scannez-le avec HiBoss sur un iPhone connecté pour approuver ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにQRコードが表示されます。サインイン済みのiPhoneのHiBossでスキャンして、このMacを承認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac покажет QR-код. Отсканируйте его в HiBoss на iPhone, где выполнен вход, чтобы одобрить этот Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 QR 코드가 표시됩니다. 로그인된 iPhone의 HiBoss로 스캔하여 이 Mac을 승인하세요."
          }
        }
      }
    },
    "Use the server your iPhone is signed in to. Only an admin or manager can approve.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the server your iPhone is signed in to. Only an admin or manager can approve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 iPhone 已登录的服务器。只有管理员或经理可以批准。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เซิร์ฟเวอร์เดียวกับที่ iPhone ลงชื่อเข้าอยู่ เฉพาะผู้ดูแลหรือผู้จัดการเท่านั้นที่อนุมัติได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el servidor en el que el iPhone tiene la sesión iniciada. Solo un administrador o un gestor puede aprobar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वही सर्वर इस्तेमाल करें जिसमें आपका iPhone साइन इन है। केवल एडमिन या मैनेजर ही स्वीकृत कर सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الخادم الذي سجّل iPhone الدخول إليه. لا يمكن الموافقة إلا لمسؤول أو مدير."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o servidor em que o iPhone está conectado. Só um administrador ou gerente pode aprovar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le serveur auquel l’iPhone est connecté. Seul un administrateur ou un responsable peut approuver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneがサインインしているサーバを使ってください。承認できるのは管理者またはマネージャーのみです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите сервер, на котором выполнен вход на iPhone. Одобрить может только администратор или менеджер."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 로그인된 서버를 사용하세요. 관리자 또는 매니저만 승인할 수 있습니다."
          }
        }
      }
    },
