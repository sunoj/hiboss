    "Current panel data has not arrived. Retry or check Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current panel data has not arrived. Retry or check Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
