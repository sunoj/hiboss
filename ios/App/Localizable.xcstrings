          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されたか、期限切れになった可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제되었거나 만료되었을 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
