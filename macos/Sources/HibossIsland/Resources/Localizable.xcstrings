    "HiBoss couldn't save the sign-in on this Mac. Start over to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss couldn't save the sign-in on this Mac. Start over to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss 无法在这台 Mac 上保存登录信息。重新开始以再试一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss บันทึกการลงชื่อเข้าบน Mac เครื่องนี้ไม่ได้ เริ่มใหม่เพื่อลองอีกครั้ง"
