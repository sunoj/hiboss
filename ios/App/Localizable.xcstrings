    "Files must be 50 MB or smaller. Choose a smaller file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files must be 50 MB or smaller. Choose a smaller file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件不能超过 50 MB。请选择较小的文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは50 MB以下にしてください。小さいファイルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 50 MB 이하여야 합니다. 더 작은 파일을 선택하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ต้องมีขนาดไม่เกิน 50 MB โปรดเลือกไฟล์ที่เล็กกว่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos deben tener un tamaño máximo de 50 MB. Elige un archivo más pequeño."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें 50 MB या उससे छोटी होनी चाहिए। कोई छोटी फ़ाइल चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا يتجاوز حجم الملفات 50 MB. اختر ملفًا أصغر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos devem ter no máximo 50 MB. Escolha um arquivo menor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers ne doivent pas dépasser 50 MB. Choisissez un fichier plus petit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер файла не должен превышать 50 MB. Выберите файл меньшего размера."
          }
        }
      }
    },
