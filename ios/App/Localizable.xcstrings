    "The demo uses sample data and never contacts a server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The demo uses sample data and never contacts a server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示使用示例数据，不会连接任何服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモではサンプルデータを使用し、サーバーには接続しません。"
