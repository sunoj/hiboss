          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस पंजीकृत करें"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل هذا الجهاز"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar este dispositivo"
          }
        },
