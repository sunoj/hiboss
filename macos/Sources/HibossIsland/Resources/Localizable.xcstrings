    "Connect to manage devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to manage devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后可管理设备。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเพื่อจัดการอุปกรณ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate para gestionar dispositivos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस प्रबंधित करने के लिए कनेक्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل لإدارة الأجهزة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se para gerenciar dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour gérer les appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを管理するには接続してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь, чтобы управлять устройствами."
          }
        }
      }
    },
    "Manage devices connected to your account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage devices connected to your account."
          }
        },
        "zh-Hans": {
