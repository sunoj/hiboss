    "The machine will not join. It can send a new request later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine will not join. It can send a new request later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该机器将不会加入。它之后可以重新发送请求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンは参加しません。後で新しいリクエストを送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신은 참가하지 않습니다. 나중에 새 요청을 보낼 수 있습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องนี้จะไม่ได้เข้าร่วม และส่งคำขอใหม่ได้ในภายหลัง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina no se unirá. Puede enviar una nueva solicitud más tarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मशीन नहीं जुड़ेगी। यह बाद में नया अनुरोध भेज सकती है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن ينضم هذا الجهاز. يمكنه إرسال طلب جديد لاحقًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina não vai entrar. Ela pode enviar uma nova solicitação depois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine ne rejoindra pas. Elle pourra envoyer une nouvelle demande plus tard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина не будет подключена. Позже она сможет отправить новый запрос."
          }
        }
      }
    },
