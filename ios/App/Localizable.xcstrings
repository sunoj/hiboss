    "Enable notifications above to receive phone alerts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications above to receive phone alerts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先启用上方的通知权限，即可接收手机提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末で通知を受け取るには、上で通知を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 알림을 받으려면 위에서 알림을 켜세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการแจ้งเตือนด้านบนเพื่อรับการแจ้งเตือนบนโทรศัพท์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones arriba para recibir avisos en el teléfono."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन पर अलर्ट पाने के लिए ऊपर सूचनाएँ चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الإشعارات أعلاه لتلقي التنبيهات على الهاتف."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações acima para receber alertas no telefone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications ci-dessus pour recevoir des alertes sur le téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите уведомления выше, чтобы получать оповещения на телефон."
          }
        }
      }
    },
    "Scan on the other iPhone, or paste the link into Pair with Code on a Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan on the other iPhone, or paste the link into Pair with Code on a Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一部 iPhone 上扫描，或在 Mac 的“使用代码配对”中粘贴链接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方の iPhone でスキャンするか、Mac の「コードでペアリング」にリンクをペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 iPhone에서 스캔하거나 Mac의 ‘코드로 페어링’에 링크를 붙여넣으세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนบน iPhone อีกเครื่อง หรือวางลิงก์ใน “จับคู่ด้วยรหัส” บน Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanéalo en el otro iPhone o pega el enlace en «Vincular con código» en un Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे iPhone पर स्कैन करें, या Mac पर “कोड से पेयर करें” में लिंक पेस्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الرمز على جهاز iPhone الآخر، أو الصق الرابط في «الإقران برمز» على Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie no outro iPhone ou cole o link em “Parear com código” em um Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez-le sur l’autre iPhone, ou collez le lien dans « Jumeler avec un code » sur un Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте на другом iPhone или вставьте ссылку в «Привязка по коду» на Mac."
          }
        }
      }
    },
    "This code works once and expires in five minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code works once and expires in five minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代码仅可使用一次，五分钟后到期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは 1 回だけ使用でき、5 分で期限切れになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 한 번만 사용할 수 있으며 5분 후에 만료돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสนี้ใช้ได้ครั้งเดียวและจะหมดอายุในห้านาที"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código funciona una sola vez y caduca en cinco minutos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड एक ही बार काम करता है और पाँच मिनट में समाप्त हो जाता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل هذا الرمز مرة واحدة وتنتهي صلاحيته خلال خمس دقائق."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código funciona uma vez e expira em cinco minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne fonctionne qu’une fois et expire dans cinq minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код действует один раз и истекает через пять минут."
          }
        }
      }
    },
    "Approve only after choosing Sign in with iPhone on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve only after choosing Sign in with iPhone on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在这台 Mac 上选择“使用 iPhone 登录”后才批准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で「iPhoneでサインイン」を選択した場合にのみ承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 ‘iPhone으로 로그인’을 선택한 경우에만 승인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุมัติหลังจากเลือก “ลงชื่อเข้าด้วย iPhone” บน Mac เครื่องนี้แล้วเท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba solo después de elegir «Iniciar sesión con el iPhone» en este Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर “iPhone से साइन इन करें” चुनने के बाद ही मंज़ूरी दें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق فقط بعد اختيار «تسجيل الدخول باستخدام iPhone» على جهاز Mac هذا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove somente depois de escolher “Entrar com o iPhone” neste Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’approuvez qu’après avoir choisi « Se connecter avec l’iPhone » sur ce Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобряйте, только если вы выбрали «Войти с помощью iPhone» на этом Mac."
          }
        }
      }
    },
    "Check that the location is where you are.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the location is where you are."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认显示的位置与你所在的位置一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された場所が現在地と一致していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 위치가 현재 위치와 같은지 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่าตำแหน่งที่แสดงตรงกับที่ที่คุณอยู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la ubicación coincide con donde estás."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचें कि स्थान वही है जहाँ आप हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من أن الموقع هو مكان وجودك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se a localização é onde você está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le lieu indiqué est celui où vous vous trouvez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что указано ваше местоположение."
          }
        }
      }
    },
    "Only type this code on a Mac that is in front of you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only type this code on a Mac that is in front of you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你面前的 Mac 上输入此代码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは目の前にある Mac でのみ入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 눈앞에 있는 Mac에서만 입력하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์รหัสนี้บน Mac ที่อยู่ตรงหน้าคุณเท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe este código solo en un Mac que tengas delante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड केवल उसी Mac पर टाइप करें जो आपके सामने है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب هذا الرمز فقط على جهاز Mac أمامك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite este código somente em um Mac que esteja na sua frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce code uniquement sur un Mac qui se trouve devant vous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводите этот код только на Mac, который находится перед вами."
          }
        }
      }
    },
    " Never read it out or send it to anyone, even if they ask for it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Never read it out or send it to anyone, even if they ask for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 即使有人索取，也不要念出或发送给任何人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 求められても、読み上げたり誰かに送信したりしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 누가 요청하더라도 소리 내어 읽거나 다른 사람에게 보내지 마세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " อย่าอ่านออกเสียงหรือส่งให้ใคร แม้จะมีคนขอก็ตาม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Nunca lo leas en voz alta ni se lo envíes a nadie, aunque te lo pidan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " इसे कभी पढ़कर न सुनाएँ और न किसी को भेजें, भले ही वे माँगें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " لا تقرأه بصوت عالٍ أو ترسله إلى أي شخص أبدًا، حتى لو طلبه."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Nunca leia em voz alta nem envie para ninguém, mesmo que peçam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Ne le lisez jamais à voix haute et ne l’envoyez à personne, même si on vous le demande."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Никогда не зачитывайте и не отправляйте его никому, даже если просят."
          }
        }
      }
    },
    "This iPhone forgets its device token and signing key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone forgets its device token and signing key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 将删除设备令牌和签名密钥。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone のデバイストークンと署名キーが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 기기 토큰과 서명 키가 삭제돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone เครื่องนี้จะลบโทเค็นอุปกรณ์และคีย์การลงนาม"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone olvidará su token de dispositivo y su clave de firma."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह iPhone अपना डिवाइस टोकन और साइनिंग कुंजी भूल जाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينسى جهاز iPhone هذا رمز الجهاز ومفتاح التوقيع."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone esquecerá o token do dispositivo e a chave de assinatura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone oubliera son jeton d’appareil et sa clé de signature."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone удалит токен устройства и ключ подписи."
          }
        }
      }
    },
    " To sign in again, pair it from another device or enter a Boss Token.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " To sign in again, pair it from another device or enter a Boss Token."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 如需再次登录，请通过另一台设备配对，或输入 Boss Token。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " もう一度サインインするには、別のデバイスからペアリングするか、Boss Token を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 다시 로그인하려면 다른 기기에서 페어링하거나 Boss Token을 입력하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " หากต้องการลงชื่อเข้าอีกครั้ง ให้จับคู่จากอุปกรณ์อื่นหรือป้อน Boss Token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Para volver a iniciar sesión, vincúlalo desde otro dispositivo o introduce un Boss Token."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " फिर से साइन इन करने के लिए, इसे दूसरे डिवाइस से पेयर करें या Boss Token डालें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " لتسجيل الدخول مجددًا، أقرنه من جهاز آخر أو أدخل Boss Token."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Para entrar novamente, pareie-o a partir de outro dispositivo ou insira um Boss Token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Pour vous reconnecter, jumelez-le depuis un autre appareil ou saisissez un Boss Token."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Чтобы снова войти, привяжите его с другого устройства или введите Boss Token."
          }
        }
      }
    },
    "Pairing links need an HTTPS server URL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing links need an HTTPS server URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对链接需要 HTTPS 服务器地址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングリンクには HTTPS のサーバー URL が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 링크에는 HTTPS 서버 URL이 필요해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์จับคู่ต้องใช้ URL เซิร์ฟเวอร์แบบ HTTPS"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de vinculación necesitan una URL de servidor HTTPS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयरिंग लिंक के लिए HTTPS सर्वर URL ज़रूरी है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب روابط الإقران عنوان URL لخادم HTTPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links de pareamento exigem uma URL de servidor HTTPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens de jumelage nécessitent une URL de serveur HTTPS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ссылок привязки нужен URL сервера с HTTPS."
          }
        }
      }
    },
    " Plain HTTP works only for localhost.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Plain HTTP works only for localhost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 普通 HTTP 仅适用于本机地址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 通常の HTTP は localhost でのみ使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 일반 HTTP는 localhost에서만 작동해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " HTTP ธรรมดาใช้ได้กับ localhost เท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " HTTP sin cifrar solo funciona con localhost."
          }
        },
        "hi": {
          "stringUnit": {
