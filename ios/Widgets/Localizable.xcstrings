    "No answer in %@ picks “%@”. That is not approval.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer in %@ picks “%@”. That is not approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若 %1$@ 内无人回答，系统会选择“%2$@”。这不代表批准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 以内に回答がなければ「%2$@」が選ばれます。承認ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 안에 답변이 없으면 “%2$@” 옵션이 선택됩니다. 승인으로 간주되지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีคำตอบภายใน %1$@ ระบบจะเลือก “%2$@” โดยไม่ถือว่าเป็นการอนุมัติ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no hay respuesta en %1$@, se elegirá «%2$@». Esto no equivale a una aprobación."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ में कोई जवाब न मिलने पर “%2$@” चुना जाएगा। यह मंज़ूरी नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم يصل رد خلال %1$@، فسيُختار «%2$@». لا يُعدّ ذلك موافقة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resposta em %1$@, será escolhido “%2$@”. Isso não é uma aprovação."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans réponse dans %1$@, « %2$@ » sera choisi. Cela ne vaut pas approbation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если за %1$@ ответа не будет, система выберет «%2$@». Это не означает одобрения."
          }
        }
      }
    },
