    },
    "Only an admin or manager can sign in a Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an admin or manager can sign in a Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员或经理可以登录 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac にサインインできるのは管理者またはマネージャーだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 또는 매니저만 Mac에 로그인할 수 있습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ดูแลระบบหรือผู้จัดการเท่านั้นที่ลงชื่อเข้าใช้ Mac ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un administrador o un gerente puede iniciar sesión en un Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एडमिन या मैनेजर ही Mac में साइन इन कर सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إلا للمسؤول أو المدير تسجيل الدخول على Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente um administrador ou gerente pode iniciar sessão em um Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un administrateur ou un responsable peut connecter un Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнить вход на Mac может только администратор или менеджер."
          }
        }
      }
    },
