    "Couldn't check all requests. Showing earlier results. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check all requests. Showing earlier results. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查所有请求，当前显示之前的结果。%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのリクエストを確認できませんでした。以前の結果を表示しています。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 요청을 확인할 수 없었어요. 이전 결과를 표시하고 있어요. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบคำขอทั้งหมดไม่ได้ แสดงผลลัพธ์ก่อนหน้าอยู่ %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron comprobar todas las solicitudes. Se muestran resultados anteriores. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी अनुरोध नहीं जाँचे जा सके। पहले के परिणाम दिखाए जा रहे हैं। %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من كل الطلبات. يتم عرض النتائج السابقة. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar todas as solicitações. Mostrando resultados anteriores. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier toutes les demandes. Affichage des résultats précédents. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить все запросы. Показаны прежние результаты. %@"
          }
        }
      }
    },
    "Requests are unavailable on this connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests are unavailable on this connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接暂无法获取请求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続ではリクエストを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에서는 요청을 사용할 수 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอไม่พร้อมใช้งานในการเชื่อมต่อนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes no están disponibles en esta conexión."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कनेक्शन पर अनुरोध उपलब्ध नहीं हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطلبات غير متاحة على هذا الاتصال."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações não estão disponíveis nesta conexão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes ne sont pas disponibles sur cette connexion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы недоступны при этом подключении."
          }
        }
      }
    },
    "Requests are still loading. Retry to check for unanswered requests.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests are still loading. Retry to check for unanswered requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求仍在加载中，请重试以检查未回复的请求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストはまだ読み込み中です。未回答のリクエストを確認するには再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청을 아직 로드하는 중이에요. 답변하지 않은 요청을 확인하려면 다시 시도하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอยังโหลดอยู่ ลองอีกครั้งเพื่อตรวจสอบคำขอที่ยังไม่ได้ตอบ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes aún se están cargando. Reintenta para comprobar si hay solicitudes sin responder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध अभी लोड हो रहे हैं। बिना जवाब वाले अनुरोध देखने के लिए फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال الطلبات قيد التحميل. أعد المحاولة للتحقق من الطلبات التي لم يُرد عليها."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações ainda estão carregando. Tente novamente para verificar solicitações sem resposta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes sont encore en cours de chargement. Réessayez pour vérifier les demandes sans réponse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы ещё загружаются. Повторите, чтобы проверить неотвеченные запросы."
          }
        }
      }
    },
    "Requests connection is not ready. Retry to reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests connection is not ready. Retry to reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求连接尚未就绪，请重试连接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストの接続の準備ができていません。再試行して再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 연결이 준비되지 않았어요. 다시 시도하여 다시 연결하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อคำขอยังไม่พร้อม ลองอีกครั้งเพื่อเชื่อมต่อใหม่"
          }
