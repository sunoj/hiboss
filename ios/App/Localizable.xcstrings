    "Couldn't reach the server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに接続できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없어요."
