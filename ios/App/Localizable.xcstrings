          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサインインリクエストはもう存在しません。Mac でもう一度始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
