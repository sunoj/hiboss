    "Transcript reloaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录已重新加载"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を再読み込みしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 다시 로드함"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดบันทึกเซสชันใหม่แล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción recargada"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्ट फिर से लोड हुआ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعيد تحميل السجل"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrição recarregada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription rechargée"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал перезагружен"
          }
        }
      }
    },
    "History was truncated on the server, so the transcript was reloaded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器上的历史记录已截断，因此重新加载了会话记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ上の履歴が切り詰められたため、記録を再読み込みしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 기록이 잘려서 기록을 다시 로드했어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติบนเซิร์ฟเวอร์ถูกตัดทอน จึงโหลดบันทึกเซสชันใหม่แล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se truncó en el servidor, así que se volvió a cargar la transcripción."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर पर इतिहास छोटा कर दिया गया था, इसलिए ट्रांसक्रिप्ट फिर से लोड किया गया।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اقتطاع السجل على الخادم، لذا أُعيد تحميل سجل الجلسة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico foi truncado no servidor, então a transcrição foi recarregada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique a été tronqué sur le serveur ; la transcription a donc été rechargée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История на сервере была сокращена, поэтому журнал загружен заново."
          }
        }
      }
    },
