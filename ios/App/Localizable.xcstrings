    "Retry keeps the original note and project for items already submitted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry keeps the original note and project for items already submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试会保留已提交内容的原始备注和项目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行では送信済み項目の元のメモとプロジェクトを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시도 시 이미 제출한 항목의 원래 메모와 프로젝트가 유지됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลองใหม่จะใช้บันทึกและโปรเจกต์เดิมของรายการที่ส่งแล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reintentar se conservan la nota y el proyecto de los elementos enviados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से कोशिश करने पर भेजे गए आइटम का मूल नोट और प्रोजेक्ट बना रहता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ إعادة المحاولة بالملاحظة والمشروع الأصليين للعناصر المرسلة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao tentar novamente, os itens enviados mantêm a nota e o projeto originais."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer conserve la note et le projet des éléments déjà envoyés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повтор сохраняет исходную заметку и проект уже отправленных элементов."
          }
        }
      }
    },
