        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@을(를) 읽을 수 없습니다. 서버 응답: %@"
          }
        }
      }
    },
    "Enter a valid HTTP or HTTPS server URL.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
