    "Sign in from the welcome screen to connect this phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in from the welcome screen to connect this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在欢迎页面登录，即可连接这部手机。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末を接続するには、ようこそ画面からサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰을 연결하려면 시작 화면에서 로그인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าจากหน้าจอต้อนรับเพื่อเชื่อมต่อโทรศัพท์เครื่องนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión desde la pantalla de bienvenida para conectar este teléfono."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन को कनेक्ट करने के लिए वेलकम स्क्रीन से साइन इन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول من شاشة الترحيب لتوصيل هذا الهاتف."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre pela tela de boas-vindas para conectar este telefone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous depuis l’écran d’accueil pour relier ce téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите на экране приветствия, чтобы подключить этот телефон."
          }
        }
      }
    },
    "Sign in to connect this phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to connect this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后即可连接这部手机。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末を接続するにはサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰을 연결하려면 로그인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าเพื่อเชื่อมต่อโทรศัพท์เครื่องนี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para conectar este teléfono."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन को कनेक्ट करने के लिए साइन इन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لتوصيل هذا الهاتف."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para conectar este telefone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour relier ce téléphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы подключить этот телефон."
          }
        }
      }
    },
    "Check your connection, then tap Reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection, then tap Reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查网络连接，然后轻点“重新连接”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認してから、「再接続」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 확인한 다음 ‘다시 연결’을 탭하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการเชื่อมต่อ แล้วแตะ “เชื่อมต่อใหม่”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la conexión y toca «Reconectar»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कनेक्शन जाँचें, फिर “फिर से कनेक्ट करें” पर टैप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من اتصالك، ثم اضغط على «إعادة الاتصال»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a conexão e toque em “Reconectar”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion, puis touchez « Reconnecter »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение и нажмите «Переподключить»."
          }
        }
      }
    },
    "Connecting to your server…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to your server…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接你的服务器…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결하는 중…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเชื่อมต่อกับเซิร์ฟเวอร์ของคุณ…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando con tu servidor…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर से कनेक्ट हो रहा है…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاتصال بخادمك…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando ao seu servidor…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à votre serveur…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к серверу…"
          }
        }
      }
    },
    "Open HiBoss again to reconnect to your server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open HiBoss again to reconnect to your server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开 HiBoss 即可重新连接你的服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに再接続するには、HiBoss をもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 다시 연결하려면 HiBoss를 다시 여세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด HiBoss อีกครั้งเพื่อเชื่อมต่อกับเซิร์ฟเวอร์ใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir HiBoss para reconectar con tu servidor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सर्वर से फिर से कनेक्ट करने के लिए HiBoss फिर से खोलें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح HiBoss مرة أخرى لإعادة الاتصال بخادمك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o HiBoss novamente para reconectar ao seu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez HiBoss pour vous reconnecter à votre serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте HiBoss снова, чтобы переподключиться к серверу."
          }
        }
      }
    },
    "This phone is connected to your server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is connected to your server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机已连接到你的服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はサーバーに接続されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 서버에 연결되어 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรศัพท์เครื่องนี้เชื่อมต่อกับเซิร์ฟเวอร์ของคุณแล้ว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono está conectado a tu servidor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन आपके सर्वर से कनेक्ट है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الهاتف متصل بخادمك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone está conectado ao seu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone est connecté à votre serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон подключён к вашему серверу."
          }
        }
