    "Your reply is still sending. Check the connection before trying again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your reply is still sending. Check the connection before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复仍在发送中。请检查连接后再尝试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信はまだ送信中です。再試行する前に接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장을 아직 보내는 중이에요. 다시 시도하기 전에 연결을 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบกลับของคุณยังส่งอยู่ ตรวจสอบการเชื่อมต่อก่อนลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu respuesta aún se está enviando. Comprueba la conexión antes de volver a intentarlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका जवाब अभी भेजा जा रहा है। फिर से कोशिश करने से पहले कनेक्शन जाँचें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال ردّك قيد الإرسال. تحقّق من الاتصال قبل المحاولة مجددًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua resposta ainda está sendo enviada. Verifique a conexão antes de tentar novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse est toujours en cours d’envoi. Vérifiez la connexion avant de réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ ещё отправляется. Проверьте подключение, прежде чем повторить."
          }
        }
      }
    },
