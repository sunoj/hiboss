          }
        }
      }
    },
    "Camera access is needed to scan the code on your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is needed to scan the code on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要相机权限才能扫描 Mac 上的代码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に表示されたコードをスキャンするにはカメラへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 표시된 코드를 스캔하려면 카메라 접근 권한이 필요합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องเข้าถึงกล้องเพื่อสแกนรหัสบน Mac ของคุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a la cámara para escanear el código de tu Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Mac पर दिखे कोड को स्कैन करने के लिए कैमरा एक्सेस चाहिए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم الوصول إلى الكاميرا لمسح الرمز على جهاز Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso acesso à câmera para escanear o código no seu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’appareil photo est nécessaire pour scanner le code de votre Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ к камере, чтобы отсканировать код на Mac."
          }
        }
      }
    },
    "%@ was not signed in": {
      "localizations": {
