          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 패널 데이터가 도착하지 않았어요. 다시 시도하거나 설정을 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
