          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 서버 URL을 입력하세요."
          }
        }
      }
    },
    "The server must use HTTPS. Plain HTTP is allowed only for localhost.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server must use HTTPS. Plain HTTP is allowed only for localhost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器必须使用 HTTPS。仅 localhost 允许使用普通 HTTP。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ต้องใช้ HTTPS อนุญาต HTTP ธรรมดาเฉพาะ localhost เท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor debe usar HTTPS. HTTP sin cifrar solo se permite para localhost."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर को HTTPS इस्तेमाल करना होगा। सादा HTTP केवल localhost के लिए अनुमत है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يستخدم الخادم HTTPS. لا يُسمح بـ HTTP العادي إلا لـ localhost."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor precisa usar HTTPS. HTTP simples só é permitido para localhost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur doit utiliser HTTPS. Le HTTP simple n’est autorisé que pour localhost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは HTTPS を使用する必要があります。通常の HTTP は localhost のみ許可されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер должен использовать HTTPS. Обычный HTTP разрешён только для localhost."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버는 HTTPS를 사용해야 해요. 일반 HTTP는 localhost에서만 허용돼요."
          }
        }
      }
    },
    "That pairing code is not valid. It starts with hb_pair_.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pairing code is not valid. It starts with hb_pair_."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该配对码无效。配对码以 hb_pair_ 开头。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสจับคู่นี้ไม่ถูกต้อง รหัสจะขึ้นต้นด้วย hb_pair_"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código de vinculación no es válido. Empieza por hb_pair_."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेयरिंग कोड मान्य नहीं है। यह hb_pair_ से शुरू होता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز الإقران هذا غير صالح. يبدأ الرمز بـ hb_pair_."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código de pareamento não é válido. Ele começa com hb_pair_."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code de jumelage n’est pas valide. Il commence par hb_pair_."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードは無効です。コードは hb_pair_ で始まります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код привязки недействителен. Код начинается с hb_pair_."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효하지 않은 페어링 코드예요. 코드는 hb_pair_로 시작해요."
          }
        }
      }
    },
    "That pairing code is no longer valid. Ask for a fresh code and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pairing code is no longer valid. Ask for a fresh code and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该配对码已失效。请获取新的配对码后重试。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสจับคู่นี้ใช้ไม่ได้แล้ว ขอรหัสใหม่แล้วลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código de vinculación ya no es válido. Pide un código nuevo e inténtalo de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेयरिंग कोड अब मान्य नहीं है। नया कोड माँगें और फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد رمز الإقران هذا صالحًا. اطلب رمزًا جديدًا وحاول مرة أخرى."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código de pareamento não é mais válido. Peça um novo código e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code de jumelage n’est plus valide. Demandez un nouveau code et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングコードは無効になりました。新しいコードを入手して、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код привязки больше не действует. Запросите новый код и повторите попытку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 유효하지 않은 페어링 코드예요. 새 코드를 받아 다시 시도하세요."
          }
        }
      }
    },
    "Your role cannot pair devices": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your role cannot pair devices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的角色无法配对设备"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทบาทของคุณจับคู่อุปกรณ์ไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rol no puede vincular dispositivos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी भूमिका डिवाइस पेयर नहीं कर सकती"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح دورك بإقران الأجهزة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua função não pode parear dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rôle ne permet pas de jumeler des appareils"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのロールではデバイスをペアリングできません"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша роль не позволяет привязывать устройства"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 역할로는 기기를 페어링할 수 없어요"
          }
        }
      }
    },
    "Ask an administrator or manager to pair this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask an administrator or manager to pair this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让管理员或经理为此设备配对。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ผู้ดูแลระบบหรือผู้จัดการจับคู่อุปกรณ์นี้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a un administrador o a un responsable que vincule este dispositivo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस को पेयर करने के लिए किसी एडमिनिस्ट्रेटर या मैनेजर से कहें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من مسؤول أو مدير إقران هذا الجهاز."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça a um administrador ou gerente para parear este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à un administrateur ou à un responsable de jumeler cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者またはマネージャーにこのデバイスのペアリングを依頼してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите администратора или менеджера привязать это устройство."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자나 매니저에게 이 기기의 페어링을 요청하세요."
          }
        }
      }
    },
    "Couldn’t redeem the pairing code. Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t redeem the pairing code. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用该配对码，请检查连接后重试。"
          }
