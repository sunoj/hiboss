    "That is not a HiBoss pairing link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a HiBoss pairing link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 HiBoss 配对链接。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่ไม่ใช่ลิงก์จับคู่ของ HiBoss"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este no es un enlace de vinculación de HiBoss."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह HiBoss पेयरिंग लिंक नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس رابط إقران HiBoss."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não é um link de pareamento do HiBoss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un lien de jumelage HiBoss."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは HiBoss のペアリングリンクではありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не ссылка для привязки HiBoss."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss 페어링 링크가 아니에요."
          }
        }
      }
    },
    "Enter both the server and the pairing code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter both the server and the pairing code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请同时输入服务器和配对码。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนทั้งเซิร์ฟเวอร์และรหัสจับคู่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el servidor y el código de vinculación."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर और पेयरिंग कोड दोनों दर्ज करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الخادم ورمز الإقران معًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe o servidor e o código de pareamento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le serveur et le code de jumelage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバとペアリングコードの両方を入力してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите сервер и код привязки."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버와 페어링 코드를 모두 입력하세요."
          }
        }
      }
    },
    "Enter a valid server URL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid server URL."
          }
        },
        "zh-Hans": {
