    "Point the app at your HiBoss server and paste a Boss Token.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将应用指向你的 HiBoss 服务器并粘贴 Boss Token。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss サーバのアドレスを指定し、Boss Token を貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss 서버 주소를 지정하고 Boss Token을 붙여 넣으세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชี้แอปไปยังเซิร์ฟเวอร์ HiBoss ของคุณ แล้ววาง Boss Token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la app a tu servidor HiBoss y pega un Boss Token."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को अपने HiBoss सर्वर से जोड़ें और Boss Token पेस्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه التطبيق إلى خادم HiBoss والصق Boss Token."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte o app para o seu servidor HiBoss e cole um Boss Token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l’adresse de votre serveur HiBoss et collez un Boss Token."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите адрес своего сервера HiBoss и вставьте Boss Token."
          }
        }
      }
    },
