    "Enter pairing code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter pairing code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入配对码"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードを入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 코드 입력"
          }
        },
