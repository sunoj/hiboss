    "Submission status is unconfirmed. Check before retrying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交状态尚未确认，请先查询再重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信状況を確認できていません。再試行する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출 상태가 확인되지 않았어요. 다시 시도하기 전에 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ยืนยันสถานะการส่ง ตรวจสอบก่อนลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado del envío no está confirmado. Compruébalo antes de reintentar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबमिशन की स्थिति की पुष्टि नहीं हुई है। फिर से कोशिश करने से पहले जाँच लें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة الإرسال غير مؤكدة. تحقق منها قبل إعادة المحاولة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O status do envio não foi confirmado. Verifique antes de tentar novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État de l’envoi non confirmé. Vérifiez avant de réessayer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус отправки не подтверждён. Проверьте его перед повтором."
          }
        }
      }
    },
