        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接失败。请下拉刷新或在设置中重新连接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続に失敗しました。引き下げて更新するか、設定で再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결에 실패했어요. 당겨서 새로 고치거나 설정에서 다시 연결하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อล้มเหลว ดึงลงเพื่อรีเฟรชหรือเชื่อมต่อใหม่ในการตั้งค่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de conexión. Desliza para actualizar o reconecta en Ajustes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन विफल रहा। रीफ़्रेश करने के लिए नीचे खींचें या सेटिंग्ज़ में फिर से कनेक्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الاتصال. اسحب للتحديث أو أعد الاتصال من الإعدادات."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na conexão. Puxe para atualizar ou reconecte em Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la connexion. Tirez pour actualiser ou reconnectez-vous dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбой подключения. Потяните для обновления или переподключитесь в Настройках."
          }
        }
      }
    },
