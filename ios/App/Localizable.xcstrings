          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande de connexion n’existe plus. Recommencez sur le Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот запрос на вход больше не существует. Начните заново на Mac."
          }
        }
      }
    },
    "Couldn’t reach your server. Check the connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach your server. Check the connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到你的服务器。请检查网络连接后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ของคุณได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con tu servidor. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर तक नहीं पहुँच सके। कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar seu servidor. Verifique a conexão e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre votre serveur. Vérifiez la connexion et réessayez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сервером. Проверьте подключение и повторите попытку."
          }
        }
      }
    },
    "That QR code is not a HiBoss sign-in code.": {
