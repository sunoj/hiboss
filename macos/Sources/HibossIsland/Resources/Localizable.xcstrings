    "Pairing links need an HTTPS server URL. Plain HTTP works only for localhost.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing links need an HTTPS server URL. Plain HTTP works only for localhost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对链接需要 HTTPS 服务器地址。普通 HTTP 仅适用于 localhost。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์จับคู่ต้องใช้ URL เซิร์ฟเวอร์แบบ HTTPS ใช้ HTTP ธรรมดาได้เฉพาะ localhost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de vinculación necesitan una URL de servidor HTTPS. HTTP sin cifrar solo funciona con localhost."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयरिंग लिंक के लिए HTTPS सर्वर URL चाहिए। सादा HTTP केवल localhost पर काम करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج روابط الإقران إلى عنوان خادم HTTPS. لا يعمل HTTP العادي إلا مع localhost."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links de pareamento exigem uma URL de servidor HTTPS. HTTP simples funciona apenas com localhost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens de jumelage exigent une URL de serveur HTTPS. Le HTTP simple ne fonctionne que pour localhost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングリンクには HTTPS のサーバ URL が必要です。通常の HTTP は localhost でのみ使用できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ссылок привязки нужен URL сервера с HTTPS. Обычный HTTP работает только для localhost."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 링크에는 HTTPS 서버 URL이 필요해요. 일반 HTTP는 localhost에서만 작동해요."
          }
        }
      }
    },
