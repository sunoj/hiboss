            "value": "Los datos actuales del panel no han llegado. Reintenta o revisa Ajustes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैनल का मौजूदा डेटा नहीं आया है। फिर से कोशिश करें या सेटिंग्ज़ जाँचें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
