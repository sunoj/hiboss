    "Critical questions can still alert; the menu bar icon keeps HiBoss visible.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧急问题仍会提醒；菜单栏图标让 HiBoss 保持可见。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緊急の質問は引き続き通知されます。メニューバーのアイコンで HiBoss をいつでも確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴급 질문은 계속 알려요. 메뉴 막대 아이콘으로 HiBoss를 언제든 확인할 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำถามระดับวิกฤตยังแจ้งเตือนได้ ไอคอนในแถบเมนูช่วยให้ยังเห็น HiBoss อยู่เสมอ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preguntas críticas aún pueden avisar; el icono de la barra de menús mantiene HiBoss visible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गंभीर प्रश्न फिर भी अलर्ट कर सकते हैं; मेनू बार आइकन से HiBoss दिखता रहता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال الأسئلة الحرجة تُنبّهك؛ وتُبقي أيقونة شريط القائمة HiBoss ظاهرًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntas críticas ainda podem alertar; o ícone na barra de menus mantém o HiBoss visível."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions critiques peuvent toujours alerter ; l’icône de la barre des menus garde HiBoss visible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Критические вопросы всё равно оповещают; значок в строке меню оставляет HiBoss на виду."
          }
        }
      }
    },
