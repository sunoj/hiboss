          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрировать это устройство"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 등록"
          }
        }
      }
    },
    "This device is using a shared or legacy token": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is using a shared or legacy token"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备正在使用共享或旧版令牌"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ใช้โทเค็นที่ใช้ร่วมกันหรือโทเค็นรุ่นเก่า"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo usa un token compartido o antiguo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस साझा या पुराने टोकन का उपयोग कर रहा है"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا الجهاز رمزًا مشتركًا أو قديمًا"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo usa um token compartilhado ou antigo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil utilise un jeton partagé ou obsolète"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは共有トークンまたは旧形式のトークンを使用しています"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство использует общий или устаревший токен"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 공유 토큰 또는 이전 방식의 토큰을 사용 중이에요"
          }
        }
      }
    },
    "Device registration failed. Connected using the pasted token; this server may not support device tokens yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device registration failed. Connected using the pasted token; this server may not support device tokens yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备注册失败。已使用粘贴的令牌连接；此服务器可能尚不支持设备令牌。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงทะเบียนอุปกรณ์ไม่สำเร็จ เชื่อมต่อโดยใช้โทเค็นที่วางไว้แล้ว เซิร์ฟเวอร์นี้อาจยังไม่รองรับโทเค็นอุปกรณ์"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo registrar el dispositivo. Se conectó con el token pegado; es posible que este servidor aún no admita tokens de dispositivo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पंजीकरण विफल रहा। पेस्ट किए गए टोकन से कनेक्ट किया गया; हो सकता है यह सर्वर अभी डिवाइस टोकन का समर्थन न करता हो।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تسجيل الجهاز. تم الاتصال باستخدام الرمز الملصوق؛ قد لا يدعم هذا الخادم رموز الأجهزة بعد."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao registrar o dispositivo. Conectado com o token colado; este servidor talvez ainda não aceite tokens de dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’enregistrement de l’appareil. Connexion établie avec le jeton collé ; ce serveur ne prend peut-être pas encore en charge les jetons d’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの登録に失敗しました。貼り付けたトークンで接続しています。このサーバはデバイストークンにまだ対応していない可能性があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зарегистрировать устройство. Подключение выполнено по вставленному токену; возможно, сервер пока не поддерживает токены устройств."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 등록하지 못했어요. 붙여 넣은 토큰으로 연결했어요. 이 서버가 아직 기기 토큰을 지원하지 않을 수 있어요."
          }
        }
      }
    },
