    "Couldn't save to Box. Check your connection and retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save to Box. Check your connection and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存到 Box。请检查连接后重试。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกลง Box ไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar en Box. Comprueba la conexión y reintenta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Box में सहेजा नहीं जा सका। कनेक्शन जाँचें और पुनः प्रयास करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الحفظ في Box. تحقق من الاتصال وأعد المحاولة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar no Box. Verifique a conexão e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer dans Box. Vérifiez la connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxに保存できませんでした。接続を確認して再試行してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить в Box. Проверьте соединение и повторите."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Box에 저장할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
