        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que se haya borrado o haya caducado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद इसे हटा दिया गया है या इसकी समय-सीमा समाप्त हो गई है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
