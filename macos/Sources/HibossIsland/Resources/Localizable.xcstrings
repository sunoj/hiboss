    "Reply failed. Your draft is saved. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply failed. Your draft is saved. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复失败，草稿已保留，请重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信に失敗しました。下書きは保存されています。もう一度お試しください。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบกลับไม่สำเร็จ บันทึกแบบร่างไว้แล้ว ลองอีกครั้ง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo responder. Tu borrador está guardado. Inténtalo de nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब नहीं भेजा जा सका। आपका ड्राफ़्ट सहेजा गया है। फिर से कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الرد. تم حفظ مسودتك. حاول مرة أخرى."
