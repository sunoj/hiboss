    "You're clear. Agents will show up here when they need a decision.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're clear. Agents will show up here when they need a decision."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部处理完毕。智能体需要决策时会显示在这里。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีงานค้าง เอเจนต์จะแสดงที่นี่เมื่อต้องการให้คุณตัดสินใจ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en orden. Los agentes aparecerán aquí cuando necesiten una decisión."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब निपट गया। जब एजेंटों को निर्णय चाहिए होगा, वे यहाँ दिखेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء معلّق. سيظهر الوكلاء هنا عندما يحتاجون إلى قرار."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo em dia. Os agentes aparecerão aqui quando precisarem de uma decisão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à traiter. Les agents apparaîtront ici lorsqu’ils auront besoin d’une décision."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要な項目はありません。エージェントが判断を必要とすると、ここに表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё чисто. Агенты появятся здесь, когда им понадобится ваше решение."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 처리했어요. 에이전트에게 결정이 필요하면 여기에 표시돼요."
          }
        }
      }
    },
