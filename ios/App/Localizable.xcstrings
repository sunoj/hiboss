    "On your Mac, choose Sign in with iPhone in HiBoss, then scan the code it shows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac, choose Sign in with iPhone in HiBoss, then scan the code it shows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上的 HiBoss 中选择“使用 iPhone 登录”，然后扫描它显示的代码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の HiBoss で「iPhone でサインイン」を選び、表示されたコードをスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 HiBoss에서 'iPhone으로 로그인'을 선택한 다음 표시된 코드를 스캔하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน Mac ให้เลือก “ลงชื่อเข้าใช้ด้วย iPhone” ใน HiBoss แล้วสแกนรหัสที่แสดง"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Mac, elige Iniciar sesión con iPhone en HiBoss y escanea el código que aparece."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac पर HiBoss में ‘iPhone से साइन इन करें’ चुनें, फिर दिखाया गया कोड स्कैन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز Mac، اختر «تسجيل الدخول باستخدام iPhone» في HiBoss، ثم امسح الرمز الذي يظهر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu Mac, escolha Iniciar sessão com iPhone no HiBoss e escaneie o código exibido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac, choisissez Se connecter avec l’iPhone dans HiBoss, puis scannez le code affiché."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Mac выберите в HiBoss «Войти с iPhone» и отсканируйте показанный код."
          }
        }
      }
    },
