      "No answer in %@ picks “%@”. That is not approval.": {
        "localizations": {
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "No answer in %@ picks “%@”. That is not approval."
            }
          },
          "zh-Hans": {
            "stringUnit": {
              "state": "translated",
              "value": "若 %@ 内未回答，将选择“%@”。这不代表批准。"
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "%1$@以内に回答がない場合は「%2$@」が選択されます。これは承認ではありません。"
            }
          },
          "ko": {
            "stringUnit": {
              "state": "translated",
              "value": "%1$@ 안에 답변이 없으면 ‘%2$@’이(가) 선택돼요. 이는 승인이 아니에요."
            }
          },
          "th": {
            "stringUnit": {
              "state": "translated",
              "value": "หากไม่ตอบภายใน %1$@ จะเลือก “%2$@” ซึ่งไม่ใช่การอนุมัติ"
            }
          },
          "es": {
            "stringUnit": {
              "state": "translated",
              "value": "Si no respondes en %1$@, se elegirá «%2$@». Eso no es una aprobación."
            }
          },
          "hi": {
            "stringUnit": {
              "state": "translated",
              "value": "%1$@ में जवाब न मिलने पर “%2$@” चुना जाएगा। यह मंज़ूरी नहीं है।"
            }
          },
          "ar": {
            "stringUnit": {
              "state": "translated",
              "value": "إذا لم تُجب خلال %1$@ فسيُختار «%2$@». هذا ليس موافقة."
            }
          },
          "pt-BR": {
            "stringUnit": {
              "state": "translated",
              "value": "Sem resposta em %1$@, será escolhido “%2$@”. Isso não é aprovação."
            }
          },
          "fr": {
            "stringUnit": {
              "state": "translated",
              "value": "Sans réponse d’ici %1$@, « %2$@ » sera choisi. Ce n’est pas une approbation."
            }
          },
          "ru": {
            "stringUnit": {
              "state": "translated",
              "value": "Если не ответить за %1$@, будет выбрано «%2$@». Это не одобрение."
            }
          }
        }
      },
