    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss uses the camera to scan the pairing code shown on your Mac and sign you in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss 使用相机扫描 Mac 上显示的配对码并完成登录。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss ใช้กล้องเพื่อสแกนรหัสจับคู่ที่แสดงบน Mac ของคุณและลงชื่อเข้าใช้ให้คุณ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss usa la cámara para escanear el código de vinculación que se muestra en tu Mac e iniciar sesión."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss आपके Mac पर दिखाया गया पेयरिंग कोड स्कैन करके आपको साइन इन करने के लिए कैमरे का उपयोग करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم HiBoss الكاميرا لمسح رمز الإقران المعروض على جهاز Mac وتسجيل دخولك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HiBoss usa a câmera para escanear o código de pareamento exibido no seu Mac e conectar você."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss utilise l’appareil photo pour scanner le code de jumelage affiché sur votre Mac et vous connecter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss はカメラを使用して、Mac に表示されたペアリングコードをスキャンし、サインインします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HiBoss использует камеру, чтобы отсканировать код привязки на экране вашего Mac и выполнить вход."
          }
        }
      }
    }
  },
  "version": "1.0"
}
