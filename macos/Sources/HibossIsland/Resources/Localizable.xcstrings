    "Paste a hiboss://pair link from a signed-in device, or type its server and one-time code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a hiboss://pair link from a signed-in device, or type its server and one-time code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴已登录设备提供的 hiboss://pair 链接，或输入其服务器和一次性配对码。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางลิงก์ hiboss://pair จากอุปกรณ์ที่ลงชื่อเข้าใช้แล้ว หรือพิมพ์เซิร์ฟเวอร์และรหัสใช้ครั้งเดียว"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un enlace hiboss://pair de un dispositivo con sesión iniciada, o escribe su servidor y su código de un solo uso."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन-इन किए गए डिवाइस से hiboss://pair लिंक पेस्ट करें, या उसका सर्वर और एक-बार वाला कोड टाइप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رابط hiboss://pair من جهاز مسجّل الدخول، أو اكتب الخادم والرمز لمرة واحدة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um link hiboss://pair de um dispositivo conectado ou digite o servidor e o código de uso único."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien hiboss://pair depuis un appareil connecté, ou saisissez son serveur et son code à usage unique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン済みのデバイスの hiboss://pair リンクを貼り付けるか、サーバとワンタイムコードを入力します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ссылку hiboss://pair с устройства, где выполнен вход, или введите сервер и одноразовый код."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인된 기기의 hiboss://pair 링크를 붙여 넣거나 서버와 일회용 코드를 입력하세요."
          }
        }
      }
    },
