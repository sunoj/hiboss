    "Type the 6-digit code your iPhone shows. It works only for this request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the 6-digit code your iPhone shows. It works only for this request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 iPhone 显示的 6 位验证码。它只对本次请求有效。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์รหัส 6 หลักที่ iPhone แสดง ใช้ได้กับคำขอนี้เท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el código de 6 dígitos que muestra el iPhone. Solo sirve para esta solicitud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर दिखा 6 अंकों का कोड टाइप करें। यह केवल इसी अनुरोध के लिए काम करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب الرمز المكوّن من 6 أرقام الذي يعرضه iPhone. يصلح لهذا الطلب فقط."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código de 6 dígitos que o iPhone mostra. Ele vale só para esta solicitação."
          }
        },
        "fr": {
