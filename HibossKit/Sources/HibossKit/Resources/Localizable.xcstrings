    "This device will lose access and stop receiving push notifications.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device will lose access and stop receiving push notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备将失去访问权限，并停止接收推送通知。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้จะเสียสิทธิ์เข้าถึงและหยุดรับการแจ้งเตือนแบบพุช"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo perderá el acceso y dejará de recibir notificaciones push."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस एक्सेस खो देगा और पुश सूचनाएँ पाना बंद कर देगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيفقد هذا الجهاز إمكانية الوصول ويتوقف عن تلقي الإشعارات الفورية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo perderá o acesso e deixará de receber notificações push."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil perdra l’accès et ne recevra plus de notifications push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはアクセスできなくなり、プッシュ通知も届かなくなります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство потеряет доступ и перестанет получать пуш-уведомления."
          }
        }
      }
    },
