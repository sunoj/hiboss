    "The one-time code is sent only to this server. Pair only with a server you trust.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one-time code is sent only to this server. Pair only with a server you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性配对码只会发送到此服务器。请仅与你信任的服务器配对。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสใช้ครั้งเดียวจะส่งไปยังเซิร์ฟเวอร์นี้เท่านั้น จับคู่กับเซิร์ฟเวอร์ที่คุณเชื่อถือเท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de un solo uso solo se envía a este servidor. Vincula solo con un servidor de confianza."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक-बार वाला कोड केवल इसी सर्वर को भेजा जाता है। केवल भरोसेमंद सर्वर से पेयर करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسَل الرمز لمرة واحدة إلى هذا الخادم فقط. لا تُقرن إلا مع خادم تثق به."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de uso único é enviado apenas a este servidor. Pareie somente com um servidor confiável."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code à usage unique est envoyé uniquement à ce serveur. Ne jumelez qu’avec un serveur de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタイムコードはこのサーバにのみ送信されます。信頼できるサーバとだけペアリングしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразовый код отправляется только на этот сервер. Выполняйте привязку только к серверу, которому доверяете."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회용 코드는 이 서버로만 전송돼요. 신뢰하는 서버와만 페어링하세요."
          }
        }
      }
    },
