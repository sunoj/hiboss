    "Changes couldn’t be saved or loaded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes couldn’t be saved or loaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存或加载设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存または読み込みできませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장하거나 로드할 수 없음"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกหรือโหลดการเปลี่ยนแปลงไม่ได้"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar ni cargar los cambios"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव सहेजे या लोड नहीं किए जा सके"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ التغييرات أو تحميلها"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar nem carregar as alterações"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer ou de charger les modifications"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить или загрузить изменения"
