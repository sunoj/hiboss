        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرسال الرد."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar a resposta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer la réponse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить ответ."
          }
        }
      }
    },
