          "stringUnit": {
            "state": "translated",
            "value": "Code expiré"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок кода истёк"
          }
        }
      }
    },
    "Start again on the Mac to get a new code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start again on the Mac to get a new code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Mac 上重新开始以获取新代码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいコードを取得するには Mac でもう一度始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 코드를 받으려면 Mac에서 다시 시작하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มใหม่บน Mac เพื่อรับรหัสใหม่"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a empezar en el Mac para obtener un código nuevo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया कोड पाने के लिए Mac पर फिर से शुरू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ من جديد على جهاز Mac للحصول على رمز جديد."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece de novo no Mac para obter um novo código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommencez sur le Mac pour obtenir un nouveau code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните заново на Mac, чтобы получить новый код."
          }
        }
      }
    },
    "Scan the code a Mac shows under Sign in with iPhone, then type the code this iPhone shows on the Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the code a Mac shows under Sign in with iPhone, then type the code this iPhone shows on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Mac 在“使用 iPhone 登录”中显示的代码，然后在 Mac 上输入这台 iPhone 显示的代码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の「iPhone でサインイン」に表示されたコードをスキャンし、この iPhone に表示されたコードを Mac に入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 'iPhone으로 로그인'에 표시된 코드를 스캔한 다음, 이 iPhone에 표시된 코드를 Mac에 입력하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนรหัสที่ Mac แสดงใน “ลงชื่อเข้าใช้ด้วย iPhone” แล้วพิมพ์รหัสที่ iPhone เครื่องนี้แสดงบน Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código que muestra un Mac en Iniciar sesión con iPhone y escribe en el Mac el código que muestra este iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac पर ‘iPhone से साइन इन करें’ में दिखा कोड स्कैन करें, फिर इस iPhone पर दिखा कोड Mac पर टाइप करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الرمز الذي يعرضه جهاز Mac ضمن «تسجيل الدخول باستخدام iPhone»، ثم اكتب على Mac الرمز الذي يعرضه هذا الـ iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código que um Mac mostra em Iniciar sessão com iPhone e digite no Mac o código que este iPhone mostra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code qu’un Mac affiche sous Se connecter avec l’iPhone, puis saisissez sur le Mac le code affiché par cet iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте код, который Mac показывает в «Войти с iPhone», затем введите на Mac код, показанный этим iPhone."
          }
        }
      }
    },
    "Connect to a server before signing in a Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a server before signing in a Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先连接服务器，再登录 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac にサインインする前にサーバーに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 로그인하기 전에 서버에 연결하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเซิร์ฟเวอร์ก่อนลงชื่อเข้าใช้ Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a un servidor antes de iniciar sesión en un Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac में साइन इन करने से पहले सर्वर से कनेक्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بخادم قبل تسجيل الدخول على Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se a um servidor antes de iniciar sessão em um Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à un serveur avant de connecter un Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к серверу, прежде чем выполнять вход на Mac."
          }
        }
      }
    },
    "Only an admin or manager can sign in a Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an admin or manager can sign in a Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员或经理可以登录 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac にサインインできるのは管理者またはマネージャーだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 또는 매니저만 Mac에 로그인할 수 있습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ดูแลระบบหรือผู้จัดการเท่านั้นที่ลงชื่อเข้าใช้ Mac ได้"
          }
