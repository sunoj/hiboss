    "Approve only if the new machine shows this code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve only if the new machine shows this code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当新机器显示此验证码时才批准"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいマシンにこのコードが表示されている場合にのみ承認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 머신에 이 코드가 표시될 때만 승인하세요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุมัติเฉพาะเมื่อเครื่องใหม่แสดงรหัสนี้เท่านั้น"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba solo si la máquina nueva muestra este código"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तभी स्वीकृत करें जब नई मशीन यही कोड दिखाए"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وافق فقط إذا كان الجهاز الجديد يعرض هذا الرمز"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove somente se a nova máquina mostrar este código"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’approuvez que si la nouvelle machine affiche ce code"
