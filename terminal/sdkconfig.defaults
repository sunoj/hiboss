# Project defaults for the hiboss ESP32 terminal.
# Copy to a local sdkconfig (generated by `idf.py`) and fill in your own values.
# The generated `sdkconfig` is gitignored — never commit real credentials.

# Wi-Fi station credentials
CONFIG_WIFI_SSID="your-wifi-ssid"
CONFIG_WIFI_PASSWORD="your-wifi-password"

# hiboss backend
CONFIG_HIBOSS_SERVER_URL="https://your-hiboss-server.example.workers.dev"
CONFIG_HIBOSS_BOSS_API_KEY="hb_boss_your_api_key_here"
